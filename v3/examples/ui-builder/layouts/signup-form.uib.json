{
  "version": 1,
  "name": "Sign-up form",
  "theme": "light",
  "root": {
    "id": "root",
    "type": "root",
    "props": {},
    "children": [
      {
        "id": "d033",
        "type": "section",
        "props": {
          "padding": 64,
          "gap": 14,
          "maxWidth": 640,
          "background": "transparent",
          "align": "center",
          "items": "center"
        },
        "children": [
          {
            "id": "d030",
            "type": "badge",
            "props": {
              "text": "Free 14-day trial",
              "tone": "info"
            }
          },
          {
            "id": "d031",
            "type": "heading",
            "props": {
              "text": "Create your account",
              "level": "h1",
              "align": "center",
              "gradient": true,
              "color": ""
            }
          },
          {
            "id": "d032",
            "type": "text",
            "props": {
              "text": "No credit card required. Cancel any time.",
              "size": "lg",
              "muted": true,
              "align": "center",
              "color": ""
            }
          }
        ]
      },
      {
        "id": "d044",
        "type": "section",
        "props": {
          "padding": 0,
          "gap": 0,
          "maxWidth": 520,
          "background": "transparent",
          "align": "center",
          "items": "stretch"
        },
        "children": [
          {
            "id": "d043",
            "type": "card",
            "props": {
              "padding": 32,
              "gap": 16,
              "radius": 20,
              "elevated": true,
              "background": "",
              "align": "left"
            },
            "children": [
              {
                "id": "d036",
                "type": "row",
                "props": {
                  "gap": 16,
                  "justify": "start",
                  "items": "stretch",
                  "equal": true,
                  "stack": true,
                  "padding": 0
                },
                "children": [
                  {
                    "id": "d034",
                    "type": "input",
                    "props": {
                      "label": "First name",
                      "placeholder": "Ada",
                      "type": "text",
                      "help": ""
                    }
                  },
                  {
                    "id": "d035",
                    "type": "input",
                    "props": {
                      "label": "Last name",
                      "placeholder": "Lovelace",
                      "type": "text",
                      "help": ""
                    }
                  }
                ]
              },
              {
                "id": "d037",
                "type": "input",
                "props": {
                  "label": "Work email",
                  "placeholder": "ada@example.com",
                  "type": "email",
                  "help": "We'll send a verification link."
                }
              },
              {
                "id": "d038",
                "type": "input",
                "props": {
                  "label": "Password",
                  "placeholder": "At least 12 characters",
                  "type": "password",
                  "help": ""
                }
              },
              {
                "id": "d039",
                "type": "select",
                "props": {
                  "label": "Team size",
                  "options": "Just me\n2–10\n11–50\n51–200\n200+"
                }
              },
              {
                "id": "d040",
                "type": "toggle",
                "props": {
                  "label": "Send me tips on getting started",
                  "on": true
                }
              },
              {
                "id": "d041",
                "type": "button",
                "props": {
                  "label": "Create account",
                  "variant": "primary",
                  "size": "lg",
                  "full": true,
                  "href": "#"
                }
              },
              {
                "id": "d042",
                "type": "text",
                "props": {
                  "text": "By continuing you agree to our Terms and Privacy Policy.",
                  "size": "sm",
                  "muted": true,
                  "align": "center",
                  "color": ""
                }
              }
            ]
          }
        ]
      },
      {
        "id": "d046",
        "type": "section",
        "props": {
          "padding": 32,
          "gap": 16,
          "maxWidth": 1040,
          "background": "transparent",
          "align": "center",
          "items": "center"
        },
        "children": [
          {
            "id": "d045",
            "type": "text",
            "props": {
              "text": "Already have an account? Sign in",
              "size": "sm",
              "muted": true,
              "align": "center",
              "color": ""
            }
          }
        ]
      }
    ]
  }
}