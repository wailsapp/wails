{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@wailsio/runtime": [
        "../../../internal/runtime/desktop/@wailsio/runtime/src/index.ts"
      ]
    }
  },
  "include": [
