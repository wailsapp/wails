version = 3

project {
  name = "Customised"
  product_name = "customised"
  identifier = "com.wails.customised"
  version = "0.1.0"
  binary_name = "Customised"
  build_number = 1
}

frontend {
  directory = "frontend"
  install = ["npm", "install"]
  build = ["npm", "run", "build"]
  dev = ["npm", "run", "dev"]
  output = "dist"
  bindings {
    typescript = false
    interfaces = false
    output = "bindings"
    models_filename = "models"
    index_filename = "index"
    time_type = "string"
  }
}

build {
  output = "bin"
  trim_path = true
  strip = true
  vcs_info = false
  obfuscated = false
}

dev {
  debounce_ms = 250
  log_level = "warn"
  watch = ["**/*.go", "wails.hcl"]
  exclude = [".git", ".wails", "bin", "node_modules", "frontend/dist"]
  use_git_ignore = true
  grace_period_ms = 1500
}

ios {
  minimum_version = "15.0"
}

android {
  minimum_sdk = 21
}

target "windows/amd64" {
