{
  "name": "@wailsio/runtime",
  "type": "module",
  "version": "3.1.0-nightly.20261028",
  "description": "Wails Runtime",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./types/plugins/*.d.ts",
      "default": "./dist/plugins/*.js"
    },
    "./cancellable": {
      "types": "./types/cancellable.d.ts",
      "default": "./dist/cancellable.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wailsapp/wails.git",
    "directory": "v3/internal/runtime/desktop/@wailsio/runtime"
  },
  "author": "The Wails Team",
  "license": "MIT",
  "homepage": "https://v3.wails.io",
  "bugs": {
    "url": "https://github.com/wailsapp/wails/issues"
  },
  "files": [
    "./dist",
    "./types"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/appregion.js",
    "./dist/contextmenu.js",
    "./dist/drag.js",
    "./src/index.ts",
    "./src/appregion.ts",
    "./src/contextmenu.ts",
    "./src/drag.ts"
  ],
  "scripts": {
    "check": "npx tsc --noEmit",
    "test": "npx vitest run",
    "test:bundles": "node --experimental-vm-modules --test scripts/embedded-runtime-check.mjs",
    "test:environment": "node --test scripts/protocol-test-environment-check.mjs",
    "test:docs": "node --test scripts/type-reference-docs-check.mjs scripts/browser-doc-links-check.mjs scripts/mdn-links-docs-check.mjs",
    "clean": "node ./scripts/clean.mjs",
    "generate:events": "task generate:events",
    "generate": "npm run generate:events",
    "prebuild": "npm run clean && npm run generate",
    "build:code": "npx tsc",
    "build:docs": "npx typedoc --gitRevision master --plugin ./scripts/type-reference-docs.mjs ./src/index.ts",
    "build:docs:md": "npx typedoc --gitRevision master --plugin typedoc-plugin-markdown --plugin ./scripts/type-reference-docs.mjs ./src/index.ts",
    "build": "npm run build:code & npm run build:docs & wait",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "promises-aplus-tests": "2.1.2",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.2",
    "typescript": "^5.7.3",
    "vite": "^8.2.4",
    "vitest": "^4.1.0",
    "@types/node": "25.8.0"
  },
  "overrides": {
    "promises-aplus-tests": {
      "mocha": "^11.1.0",
      "sinon": "^19.0.2",
      "underscore": "^1.13.7"
    },
    "serialize-javascript": "^7.1.3",
    "diff": "^8.0.2"
  }
}
