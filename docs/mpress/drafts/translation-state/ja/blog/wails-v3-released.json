    "b0053-text-01": {
      "sourceHash": "916be5a0ed52bac4262e509d43d1cbca117c1c318f9291aaa1d97d94e68f2d58",
      "targetHash": "edb9061ca8f8c6525ad09baf2c69405ae125570c7a6fc3149b3da06d4e04979f",
      "machineHash": "edb9061ca8f8c6525ad09baf2c69405ae125570c7a6fc3149b3da06d4e04979f",
      "machineText": "初期の広範なプラットフォーム対応を担った[Travis McLane](https://github.com/tmclane)、アセットサーバーとネイティブプラットフォームの基盤を構築した[Stffabi](https://github.com/stffabi)、通知、Dock統合、その他のデスクトップ機能を開発した[Zach Botterman（popaprozac）](https://github.com/popaprozac)、型付きイベントとランタイムの改善に取り組んだ[Ian VanSchooten（IanVS）](https://github.com/IanVS)、Linux対応を担った[Lyimmi](https://github.com/Lyimmi)にも感謝します。これらの貢献は、構築と改良に携わったすべての皆さんの成果とともに、今もv3の一部として受け継がれています。",
      "status": "machine-translated",
      "sourcePreview": "Thank you also to [Travis McLane](https://github.com/tmclane) for his extensive early platform work;…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:45:19Z"
    },
    "b0054-text-01": {
