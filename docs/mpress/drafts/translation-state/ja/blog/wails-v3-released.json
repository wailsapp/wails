    "b0052-text-01": {
      "sourceHash": "df109e0d43319973464950e203bbe53f59a734444914296ddc8550df1fc4bb47",
      "targetHash": "8d7edfac4e5afcbe8a5357c12bb595e3ac36b8ddb2fb4aa933313c6efcf665dd",
      "machineHash": "8d7edfac4e5afcbe8a5357c12bb595e3ac36b8ddb2fb4aa933313c6efcf665dd",
      "machineText": "このように素晴らしい静的ソース解析ツールとバインディングジェネレーターを開発してくださった[Fabio Massaioli（fbbdev）](https://github.com/fbbdev)に、特別な感謝を捧げます。これはv3の仕組みを支える非常に重要な要素です。通常のGoサービスがJavaScriptおよびTypeScriptのAPIへと変換され、型とドキュメントもフロントエンドに引き継がれます。",
      "status": "machine-translated",
      "sourcePreview": "Special thanks to [Fabio Massaioli (fbbdev)](https://github.com/fbbdev) for creating such an amazing…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:45:19Z"
