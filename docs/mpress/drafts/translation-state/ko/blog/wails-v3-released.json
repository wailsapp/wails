    "b0005-text-01": {
      "sourceHash": "37e45f8bb6db3867ca7f8edb0a2d5999818e43386d382bab6848fe488361d9db",
      "targetHash": "36f8828715e9a2362c4953bf5b12058e977296957e17cc6b5dd119ae212276ed",
      "machineHash": "36f8828715e9a2362c4953bf5b12058e977296957e17cc6b5dd119ae212276ed",
      "machineText": "Wails를 처음 접하는 분을 위해 설명하자면, Wails를 사용하면 Go 프로그래머가 이미 익숙한 웹 프런트엔드 도구와 각 플랫폼의 네이티브 WebView를 이용해 데스크톱 애플리케이션을 빌드할 수 있습니다. 내장 브라우저를 사용하지 않습니다. 백엔드는 Go로, UI는 HTML, CSS, JavaScript(또는 원하는 프레임워크)로 작성하면 Wails가 이 모든 것을 하나의 네이티브 애플리케이션으로 묶어 줍니다.",
      "status": "machine-translated",
      "sourcePreview": "If you're new here: Wails lets Go programmers build desktop applications with the web frontend tools…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:45:16Z"
    },
