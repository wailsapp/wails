    "b0002-text-01": {
      "sourceHash": "67452cf276bdcad745b95180be79317d91eebcc42df1a86d8092bb651f31b4c7",
      "targetHash": "04191ca29cbdac70472686d7d434e974b8e397309c1764b6904397ad42216988",
      "machineHash": "04191ca29cbdac70472686d7d434e974b8e397309c1764b6904397ad42216988",
      "machineText": "通过远程桌面 (RDP) 会话使用 Wails 应用时，以下常见交互可能导致 UI 卡顿数秒：",
      "status": "final",
      "sourcePreview": "When a Wails application is used over a Remote Desktop (RDP) session, the UI can stall for several s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
