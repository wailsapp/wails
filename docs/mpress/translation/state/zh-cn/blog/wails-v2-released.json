    "b0026-text-01": {
      "sourceHash": "7b6a4778afa51184a13cfe7467046bdbe5080dbd3b2e89d5859945d1aa7e9e93",
      "targetHash": "01dd66a48f093196620c2d823bfb2f036871958cfb86fd6778cbbc991037d49d",
      "machineHash": "01dd66a48f093196620c2d823bfb2f036871958cfb86fd6778cbbc991037d49d",
      "machineText": "我想特别提到几个人：",
      "status": "final",
      "sourcePreview": "There are a few people I'd like to give special mention to:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
