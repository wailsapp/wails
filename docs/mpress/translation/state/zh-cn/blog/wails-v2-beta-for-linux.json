    "b0012-text-01": {
      "sourceHash": "48d705d794419374c335c65cac7cef32f970e4174656dff05fe94f8c693f30ab",
      "targetHash": "8dba864af5de7a9ef4af306c915cf9adf4f8d9cca0a55225f869f02b6c20e512",
      "machineHash": "8dba864af5de7a9ef4af306c915cf9adf4f8d9cca0a55225f869f02b6c20e512",
      "machineText": "只需将一个包含所有资源的`embed.FS`传入应用程序配置即可。这些资源甚至不必位于顶层目录中——Wails 会自动为你处理。",
      "status": "final",
      "sourcePreview": "You just pass a single `embed.FS` that contains all your assets into your\\ application configuration…",
