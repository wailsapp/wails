    "b0016-text-01": {
      "sourceHash": "4019f2356f1f499a747fd979f26455e8aa77e870ca34e5e4db44d7567a514a13",
      "targetHash": "00a3f6c1d8bbee071ebc3c8659a2bbabc8a74abbdac19c18c169b04e490ddf07",
      "machineHash": "00a3f6c1d8bbee071ebc3c8659a2bbabc8a74abbdac19c18c169b04e490ddf07",
      "machineText": "热重载——前端资源发生任何变化时，应用程序前端都会自动重新加载",
