    "b0023-text-01": {
      "sourceHash": "3182833977226bbc49cafe91543d48b546ae2a5bc33b9b186a5889c0e66279b9",
      "targetHash": "b062568ed1ec0c2acee984a423e1addf7ab95ca5c5d7870639231727ff5da72f",
      "machineHash": "b062568ed1ec0c2acee984a423e1addf7ab95ca5c5d7870639231727ff5da72f",
      "machineText": "\u003cstrong\u003e全新的文档网站。\u003c/strong\u003e文档现已由我们自己的文档工具[M-Press](https://m-press.me)驱动，译文也已完成并从社区迁移过来。英文文档仍是唯一权威来源。",
      "status": "machine-translated",
