    "b0042-text-01": {
      "sourceHash": "f152d075f74c0bb12a0b386727f5befce504801975d2d4abfe3bed495f4f3b84",
      "targetHash": "c93f097525d39947e85bc956652908272eaa19a133a028510eab67c55f424837",
      "machineHash": "c93f097525d39947e85bc956652908272eaa19a133a028510eab67c55f424837",
      "machineText": "Wails 的发展规模远超我的预期，要跟上大量议题和拉取请求一直很困难。有时发布缺乏固定安排，修复和社区贡献也要等待太久才能送达用户。我们已经建立了一些系统，以便将议题分类和发布准备中的更多基础工作自动化，从而更快地响应问题，并投入更多时间交付改进和新功能。",
      "status": "machine-translated",
      "sourcePreview": "Wails has grown far beyond what I expected, and it has been hard to keep up with the volume of issue…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
