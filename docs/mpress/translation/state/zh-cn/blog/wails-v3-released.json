    "b0022-text-01": {
      "sourceHash": "abbb69cabbfc7e5b71ae5bd09af5171ac3524c68e597a4de68e04060a1cdae07",
      "targetHash": "42b33bb45b7962bdf8e0d2e2457a192dee758b5a0eb12503c667746550883761",
      "machineHash": "42b33bb45b7962bdf8e0d2e2457a192dee758b5a0eb12503c667746550883761",
      "machineText": "Beta 版文章于 2 月发布，此后变更日志一直在不断更新。以下是我想特别介绍的几项内容：",
      "status": "machine-translated",
      "sourcePreview": "The beta post went out on 2 August, and the changelog has been busy since then. A few things I want …",
      "provider": "codex",
