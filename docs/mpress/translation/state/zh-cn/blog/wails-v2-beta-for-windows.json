    "b0047-text-01": {
      "sourceHash": "d3420ebcc796a132d8fe5a7db5d6cc542c4556f319ee52681fefa33a211c7f78",
      "targetHash": "d7a4ec28a61f9355d9749cee0d105137d1e27d2fbbe7216c74093f27069890fd",
      "machineHash": "d7a4ec28a61f9355d9749cee0d105137d1e27d2fbbe7216c74093f27069890fd",
      "machineText": "最后，我还要特别感谢所有[项目赞助者](/credits/#sponsors)，其中包括[JetBrains](https://www.jetbrains.com?from=Wails)。他们的支持在幕后以多种方式推动着项目发展。",
