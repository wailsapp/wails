    "b0030-text-01": {
      "sourceHash": "21f22fc1ff55c7a75b6b5574f826d92ee1b3fa64a2bd776efe2635278901f3c5",
      "targetHash": "80d20e3f3f72f19ab404e80c294d353052e4063c34fb12da46a45aec41a2bc02",
      "machineHash": "80d20e3f3f72f19ab404e80c294d353052e4063c34fb12da46a45aec41a2bc02",
      "machineText": "热重载——前端资源发生任何更改时，都会触发应用程序前端自动重新加载",
      "status": "final",
      "sourcePreview": "Hot reload - Any changes to frontend assets will trigger and auto reload of the application frontend",
