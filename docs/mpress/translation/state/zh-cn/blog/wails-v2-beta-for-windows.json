      "targetHash": "34fc39c979fc2cbef79f6ed07f4d0c16bb53b6230aca16b2c2cebdcb82b29080",
      "machineHash": "34fc39c979fc2cbef79f6ed07f4d0c16bb53b6230aca16b2c2cebdcb82b29080",
      "machineText": "自动重新构建——Go 代码发生任何更改时，都会重新构建并重新启动应用程序",
      "status": "final",
      "sourcePreview": "Auto rebuild - Any changes to your Go code will rebuild and relaunch your application",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
