      "machineHash": "a02cba73931acc5e57ace72a37224bf8a20970f248c261dc174db5aef2bfd332",
      "machineText": "全局快捷键使用 Win32 `RegisterHotKey` API。系统会抑制自动重复，因此按住按键只会触发一次回调，而不会反复触发。",
      "status": "machine-translated",
      "sourcePreview": "Global shortcuts use the Win32 `RegisterHotKey` API. Auto repeat is suppressed, so holding the keys …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:09:26Z"
