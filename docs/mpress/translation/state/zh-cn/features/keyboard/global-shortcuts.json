    "b0038-text-01": {
      "sourceHash": "b3870b952e6078266994b9ea15d8b170b940d8ea15ab03e4d6fd7350507481bd",
      "targetHash": "98576789ebdf7f4c3f8d70e9e44e52f09b9ba89b278768f080a8b43e95aa50dd",
      "machineHash": "98576789ebdf7f4c3f8d70e9e44e52f09b9ba89b278768f080a8b43e95aa50dd",
      "machineText": "如果组合键已被另一个应用程序占用，注册将会失败，因此默认快捷键应优先选用不太常见的组合键。",
      "status": "machine-translated",
      "sourcePreview": "Registration fails if another application already owns the combination, so prefer less common combin…",
