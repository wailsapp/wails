    "b0008-text-01": {
      "sourceHash": "812dba13be1f1fa5514a4cca9d77f926e5a956107d7988d05b9b1dd37ba1dc40",
      "targetHash": "1ba90540baa8928b53cab44d59082c7f7c41daed43dee7f50839c6c5f9098488",
      "machineHash": "1ba90540baa8928b53cab44d59082c7f7c41daed43dee7f50839c6c5f9098488",
      "machineText": "Wails v3 offre une prise en charge robuste de la zone de notification, ce qui permet à votre application de rester présente en permanence sur le bureau de l’utilisateur. Cette fonctionnalité est particulièrement utile pour les applications qui doivent s’exécuter en arrière-plan ou donner un accès rapide à des fonctions essentielles.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces robust support for system tray functionality, allowing your\\ application to main…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0009-text-01": {
      "sourceHash": "7c3f7d8692501289caf2dce27685e8b2928b4a0b7b44947051cbd7b1ead70743",
      "targetHash": "6b3be98e0ee6b8df675666c2a699b577cc49ce8440eab7392a5f228c1ef4c959",
      "machineHash": "6b3be98e0ee6b8df675666c2a699b577cc49ce8440eab7392a5f228c1ef4c959",
      "machineText": "Les principales fonctionnalités de l’intégration de Wails v3 à la zone de notification sont les suivantes :",
      "status": "final",
      "sourcePreview": "Key features of the Wails v3 system tray integration include:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0010-text-01": {
      "sourceHash": "dedec9bcc95b13e7903f3318a8f656c684ce2ef9442d517a6d61c0f6fed86341",
      "targetHash": "709910e6e6d50007102f3f33fc32ce03f7c743180b0f7dd1509529c78f5c81ff",
      "machineHash": "709910e6e6d50007102f3f33fc32ce03f7c743180b0f7dd1509529c78f5c81ff",
      "machineText": "Association d’une fenêtre : vous pouvez associer une fenêtre à l’icône de la zone de notification. Lorsqu’elle est activée, cette fenêtre est centrée par rapport à la position de l’icône, ce qui permet d’accéder rapidement à votre application.",
      "status": "final",
      "sourcePreview": "Window Attachment: You can associate a window with the system tray icon. When activated, this window…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0011-text-01": {
      "sourceHash": "c2ac5f848de9266216c12bfe9678ae18c7ad7be6ffd44d47fae52707143afcf3",
      "targetHash": "b3ed7990dfbea16029d96993b5e7a7f7ee7ac31fd938cf21d839918147965101",
      "machineHash": "b3ed7990dfbea16029d96993b5e7a7f7ee7ac31fd938cf21d839918147965101",
      "machineText": "Prise en charge complète des menus : créez des menus riches et interactifs auxquels les utilisateurs peuvent accéder directement depuis l’icône de la zone de notification. Ils peuvent ainsi effectuer rapidement des actions sans devoir ouvrir la fenêtre complète de l’application.",
      "status": "final",
      "sourcePreview": "Comprehensive Menu Support: Create rich, interactive menus that users can access directly from the s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0012-text-01": {
      "sourceHash": "658ceb4bb27d5ead74c07762c0f35c20944272d46936abb25817a6e31adada0f",
      "targetHash": "0d6110a1e826999ce34e5a0071e31f69fbcffcc2f679ef29606212494a1158b4",
      "machineHash": "0d6110a1e826999ce34e5a0071e31f69fbcffcc2f679ef29606212494a1158b4",
      "machineText": "Affichage adaptatif de l’icône : la prise en charge des icônes pour les modes clair et sombre garantit que l’icône de votre application dans la zone de notification reste visible et esthétique avec les différents thèmes système. Les icônes de modèle sont également prises en charge sous macOS.",
      "status": "final",
      "sourcePreview": "Adaptive Icon Display: Support for both light and dark mode icons ensures your application's system …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0013-heading-01": {
      "sourceHash": "5a7e46316522863bcbdf3cf0e140bbb7f1aa98f04f19bcb15541814acbc84753",
      "targetHash": "7665f71ee40d7654533bb30b2344868d9eebd2ecc77df1d71d7779dc8cbb4204",
      "machineHash": "7665f71ee40d7654533bb30b2344868d9eebd2ecc77df1d71d7779dc8cbb4204",
