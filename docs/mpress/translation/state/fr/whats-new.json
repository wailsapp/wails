    "b0004-text-01": {
      "sourceHash": "7d1ecd1f084733419a78b06a0c02f89cdf223d4c7fb04f24bae725580e28ff0f",
      "targetHash": "456ae2fd7ad9200586e09882ccd2c4692f05e0cdc01f2d2cb8f3bcba6a214db9",
      "machineHash": "456ae2fd7ad9200586e09882ccd2c4692f05e0cdc01f2d2cb8f3bcba6a214db9",
      "machineText": "Wails v3 permet de créer et de gérer plusieurs fenêtres au sein d’une même application. Cette fonctionnalité permet aux développeurs de concevoir des interfaces utilisateur plus complexes et polyvalentes, sans les limites propres aux applications à fenêtre unique.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces the ability to create and manage multiple windows within a\\ single application. …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0005-text-01": {
      "sourceHash": "34b6425086cc6a8c77ed211279c651c5f89db9cc9574b2cfb827a6bea7d7edb0",
      "targetHash": "1624f0488951f22366fcd46322ec5d6bc246cf4cde865f61ed645f4c9ca02c5b",
      "machineHash": "1624f0488951f22366fcd46322ec5d6bc246cf4cde865f61ed645f4c9ca02c5b",
      "machineText": "Chaque fenêtre peut être configurée indépendamment, notamment en matière de taille, de position, de contenu et de comportement. Vous pouvez ainsi créer des applications comportant des fenêtres distinctes pour différentes fonctionnalités, telles qu’une interface principale, des panneaux de paramètres ou des vues auxiliaires.",
      "status": "final",
      "sourcePreview": "Each window can be independently configured, providing flexibility in terms of\\ size, position, cont…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0006-text-01": {
      "sourceHash": "8a62723601fbd79ef9323a585693e97cef3d6f85d55b7d7096c022411c6ddbbb",
      "targetHash": "139b1739d76b9b47dcfed44063f3e474a763346b721da5ded3531ce1432dbf38",
      "machineHash": "139b1739d76b9b47dcfed44063f3e474a763346b721da5ded3531ce1432dbf38",
      "machineText": "Les développeurs peuvent créer, manipuler et gérer ces fenêtres par programmation afin de produire des interfaces utilisateur dynamiques qui s’adaptent aux besoins des utilisateurs et aux états de l’application.",
      "status": "final",
      "sourcePreview": "Developers can create, manipulate, and manage these windows programmatically,\\ allowing for dynamic …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0007-heading-01": {
      "sourceHash": "90c7844e5ce6a8838322b75b3d78aad465958c9987df0a3c78a43cf82ca51290",
      "targetHash": "1d36029db271015c6500b075c1330455059b8082f3929eab66e75a75d70b8d80",
      "machineHash": "1d36029db271015c6500b075c1330455059b8082f3929eab66e75a75d70b8d80",
      "machineText": "Intégration à la zone de notification",
      "status": "final",
      "sourcePreview": "System Tray Integration",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
