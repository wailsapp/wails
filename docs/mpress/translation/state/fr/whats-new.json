    "b0001-text-01": {
      "sourceHash": "44479da91d327a99d03a59ecd05a869c26846bcf93c03e8dc6243a360961da4d",
      "targetHash": "d7bc00f1d3482227724cf7ca479503e1c8ac1bc396f55ba6ba079fa837099e53",
      "machineHash": "d7bc00f1d3482227724cf7ca479503e1c8ac1bc396f55ba6ba079fa837099e53",
      "machineText": "Wails v3 apporte des changements importants par rapport à v2. Il remplace l’API déclarative à fenêtre unique par une approche procédurale plus souple. Cette nouvelle conception de l’API améliore la lisibilité du code et simplifie le développement, en particulier pour les applications complexes à plusieurs fenêtres.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces significant changes from v2. It replaces the\\ single-window, declarative API wit…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0002-text-01": {
      "sourceHash": "97c252aca10ec764355d68d945df86e9e1c3cfea84c0d5539e8e58e819f750d3",
      "targetHash": "0960b04dad39b5e6f1eec455033944cb382ba6730568b4c56363e0cb95cdfaa2",
      "machineHash": "0960b04dad39b5e6f1eec455033944cb382ba6730568b4c56363e0cb95cdfaa2",
      "machineText": "Wails v3 représente une évolution majeure dans la manière de créer des applications de bureau avec Go et les technologies web.",
      "status": "final",
      "sourcePreview": "Wails v3 represents a substantial evolution in how desktop applications\\ can be built using Go and w…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
