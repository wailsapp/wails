    "b0014-text-01": {
      "sourceHash": "8fb41de9280116fc966305d32ddf032f540af11a632f6d6c34eb5d67fd339156",
      "targetHash": "9ebdf943b9c4d77af16b4c636d049574cfe2f67c62882bc2f2fe083a8d1799b5",
      "machineHash": "9ebdf943b9c4d77af16b4c636d049574cfe2f67c62882bc2f2fe083a8d1799b5",
      "machineText": "Wails v3 améliore considérablement la génération des bindings de votre projet. Les bindings relient votre backend Go à votre frontend et permettent une communication fluide entre les deux.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces a significant improvement in how bindings are generated for\\ your project. Bindi…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
