    "b0001-text-01": {
      "sourceHash": "df9d00566eaab0ad4d01d375f60c441e7c0a9107b32924af26eaf9f0893985ee",
      "targetHash": "3f95ca178e605c9ec23c6a6bc726ee30c366cc4b65760bf11ccb64c98322789d",
      "machineHash": "3f95ca178e605c9ec23c6a6bc726ee30c366cc4b65760bf11ccb64c98322789d",
      "machineText": "Wails permet aux utilisateurs de faire glisser des fichiers depuis le système d’exploitation (gestionnaire de fichiers, bureau) vers votre application. Contrairement au glisser-déposer HTML5, qui ne fonctionne qu’au sein du navigateur, cette fonctionnalité vous donne accès aux chemins réels des fichiers sur le disque.",
      "status": "final",
      "sourcePreview": "Wails lets users drag files from the operating system (file manager, desktop) into your application.…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:26Z"
    },
