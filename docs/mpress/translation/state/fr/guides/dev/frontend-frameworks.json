    "b0018-text-01": {
      "sourceHash": "8a449bb8f7b7fc6f5a19868d04e4afe3eb4e94f058df87e3b82e43fab4ac8758",
      "targetHash": "7a5c9c3e3166f25bb978fb51e5f9d44d5fea50d355150c936a23b891c8e2a39e",
      "machineHash": "7a5c9c3e3166f25bb978fb51e5f9d44d5fea50d355150c936a23b891c8e2a39e",
      "machineText": "Wails ne se préoccupe pas du framework qui se trouve dans `frontend/`. Il repose uniquement sur un contrat minimal et indépendant du framework :",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
