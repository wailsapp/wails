    "b0016-text-01": {
      "sourceHash": "ebfb936b1107987c6e60a63ff64c916ed77d9cdd44ff86a53ddd1a927571de91",
      "targetHash": "4f6a81ccf27ca74409d1d4dcb81c1da594e74794abe523de1e19f2d20e1a2c9e",
      "machineHash": "4f6a81ccf27ca74409d1d4dcb81c1da594e74794abe523de1e19f2d20e1a2c9e",
      "machineText": "Cela ne signifie pas que ce sont vos seules options. Le frontend d’une application Wails est *simplement un projet web* : tout ce qui produit du HTML, du CSS et du JS statiques fonctionnera. Si le framework de votre choix (Solid, Preact, Lit, Qwik, SvelteKit, Angular, etc.) ne dispose pas de modèle, vous pouvez générer vous-même sa structure en quelques minutes.",
      "status": "final",
      "sourcePreview": "That doesn't mean those are your only options. The frontend of a Wails app is *just a\\ web project* …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:27Z"
    },
