      "machineHash": "ade4451f332e29d3f65df9a677320e06db07900f15ce478618b7ebf029814704",
      "machineText": "*`frontend/dist/` correspond à ce qui est distribué.* `main.go` incorpore le frontend compilé avec `//go:embed all:frontend/dist` et le fournit depuis le serveur de ressources. Votre processus de compilation doit produire un bundle statique dans `frontend/dist/`, le répertoire de sortie par défaut de Vite.",
      "status": "final",
      "sourcePreview": "*`frontend/dist/` is what ships.* `main.go` embeds the built frontend with `//go:embed all:frontend/…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:27Z"
    },
    "b0020-text-01": {
      "sourceHash": "85e415e7c1f9045cbb3a31fee14621a3ec827c2e4478d35a23e435edbe2913f0",
