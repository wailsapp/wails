    "b0018-text-01": {
      "sourceHash": "577a37569311214507401947d948a2d81e40e3399904dfa55f726af2a3a9f50c",
      "targetHash": "b595cea0fa6f2b63ef85e342c4ac9014ff80e0ea593fba3e28c5e35df47655f3",
      "machineHash": "b595cea0fa6f2b63ef85e342c4ac9014ff80e0ea593fba3e28c5e35df47655f3",
      "machineText": "Google Play exige le format Android App Bundle (`.aab`) pour toute nouvelle\\\napplication, qui doit cibler Android 15 (API 35) ou une version ultérieure ;\\\nle modèle de projet définit `compileSdk` et `targetSdk` sur 35 dans\\\n`build/android/app/build.gradle`. `wails3 task android:bundle:fat` produit\\\n`bin/\u003cAppName\u003e.aab` en incluant les deux ABI ; Google Play génère à partir de celui-ci\\\ndes APK optimisés pour chaque appareil. Ce bundle universel est donc l’artefact approprié\\\nà envoyer sur la boutique. Les APK restent la solution la plus rapide pour les tests locaux et\\\nsur émulateur, car un `.aab` ne peut pas être installé directement avec `adb`.",
      "status": "final",
      "sourcePreview": "Google Play requires the Android App Bundle (`.aab`) format for new app\\ submissions, and new submis…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
