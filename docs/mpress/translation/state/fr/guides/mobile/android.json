    "b0018-text-01": {
      "sourceHash": "769ff937a36c06584cae2d73ff3afe166d88449d2dd4b085ec9ba1a39e0902ab",
      "targetHash": "3f2c8a9aaeabcb9d536adda0ec19e48434fdb962ed105dc5d5b91e10551235af",
      "machineHash": "3f2c8a9aaeabcb9d536adda0ec19e48434fdb962ed105dc5d5b91e10551235af",
      "machineText": "Google Play exige le format Android App Bundle (`.aab`) pour les nouvelles applications, qui doivent cibler Android 15 (API 35) ou une version ultérieure ; le modèle de projet définit `compileSdk` et `targetSdk` sur 35 dans `build/android/app/build.gradle`. `wails3 task android:bundle:fat` produit `bin/\u003cAppName\u003e.aab` en incluant les deux ABI ; Google Play génère à partir de ce fichier des APK optimisés pour chaque appareil. Ce bundle universel est donc l’artefact approprié à téléverser sur la boutique. Les APK restent la solution la plus rapide pour les tests locaux et sur émulateur, car un fichier `.aab` ne peut pas être installé directement avec `adb`.",
      "status": "machine-translated",
      "sourcePreview": "Google Play requires the Android App Bundle (`.aab`) format for new app submissions, and new submiss…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
