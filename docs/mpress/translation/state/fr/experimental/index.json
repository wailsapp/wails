      "b0002-heading-01": {
        "sourceHash": "338b0fd20d9611d9131d9cd9758fab344042b9234e17e39e139c3fec152504ff",
        "targetHash": "979d91db1a3779e92fab152f3146c52df66c0943e358af46a3e14ef0b3a4603d",
        "machineHash": "979d91db1a3779e92fab152f3146c52df66c0943e358af46a3e14ef0b3a4603d",
        "machineText": "Ce que signifie « expérimental »",
        "status": "final",
        "sourcePreview": "What \"Experimental\" means",
        "provider": "codex",
        "model": "gpt-5.6-sol",
        "promptVersion": "mpress-translation-v2",
        "updatedAt": "2026-09-13T23:13:25Z"
      },
      "b0003-text-01": {
        "sourceHash": "3c91298071708809485a263f45cda29c9475c8a61c4d9d32ff191ffe6985eb93",
        "targetHash": "f3ba35d35e3435a8aa7855a38930961856386eea828ce6fea598ffea56ce1290",
        "machineHash": "f3ba35d35e3435a8aa7855a38930961856386eea828ce6fea598ffea56ce1290",
        "machineText": "Wails publie ses expérimentations au grand jour. Une expérimentation est une idée qui nous paraît suffisamment prometteuse pour vous être proposée en avant-première, mais sur laquelle nous ne nous sommes pas encore pleinement engagés. Nous la publions _parce que_ nous voulons tirer les enseignements d’une utilisation réelle avant de décider si elle doit devenir une composante permanente et prise en charge de Wails.",
        "status": "final",
        "sourcePreview": "Wails ships experiments in the open. An experiment is an idea we think is\\ promising enough to put i…",
        "provider": "codex",
        "model": "gpt-5.6-sol",
        "promptVersion": "mpress-translation-v2",
        "updatedAt": "2026-09-13T23:13:25Z"
      },
      "b0004-text-01": {
        "sourceHash": "631afd4f53361159932cd8500f4b4d60b30159f2dfec1d194e980c1d1f9edae7",
