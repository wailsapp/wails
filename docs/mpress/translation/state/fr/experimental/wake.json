    "b0029-text-01": {
      "sourceHash": "cf845163f68c4801cb6daeea427d279b43ae53a452f659052e65868e1971d643",
      "targetHash": "529844649a3bf14f7d353dbd05fd081448a3ca711e824a1b59b807a8582cbfc4",
      "machineHash": "529844649a3bf14f7d353dbd05fd081448a3ca711e824a1b59b807a8582cbfc4",
      "machineText": "Une tâche portant le *même nom* remplace la tâche de base. Lorsqu’ils sont fournis par la surcharge, les champs de type liste (`cmds`, `deps`, `sources`, `generates`, `platforms`, `status`, `preconditions`, `aliases`) *remplacent* ceux de la base ; les champs omis par la surcharge sont conservés depuis la base.",
      "status": "final",
      "sourcePreview": "A task with the *same name* overrides the base task. List fields (`cmds`, `deps`, `sources`, `genera…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:25Z"
    },
    "b0030-text-01": {
      "sourceHash": "2e6c81f509162acc33e81a9c9db6ac2e6fca3400db59c5081d7be4fc792bfde0",
      "targetHash": "db3e65f47aecb409bc750e665c998626f6c1dc9f8dabd5d828038951bf9df56f",
      "machineHash": "db3e65f47aecb409bc750e665c998626f6c1dc9f8dabd5d828038951bf9df56f",
      "machineText": "`env` et `vars` sont *fusionnés clé par clé*, la surcharge étant prioritaire en cas de conflit.",
      "status": "final",
      "sourcePreview": "`env` and `vars` *merge per key*, with the override winning on collisions.",
