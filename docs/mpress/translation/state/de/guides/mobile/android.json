    "b0018-text-01": {
      "sourceHash": "769ff937a36c06584cae2d73ff3afe166d88449d2dd4b085ec9ba1a39e0902ab",
      "targetHash": "cd346c5bb78ab840127c5d623be044f2fe2e6a9b251f77e443fb9e8ec3094a32",
      "machineHash": "cd346c5bb78ab840127c5d623be044f2fe2e6a9b251f77e443fb9e8ec3094a32",
      "machineText": "Google Play verlangt für neue App-Einreichungen das Android-App-Bundle-Format (`.aab`). Außerdem müssen neue Einreichungen auf Android 15 (API 35) oder höher ausgerichtet sein. Die Projektvorlage setzt `compileSdk` und `targetSdk` in `build/android/app/build.gradle` auf 35. `wails3 task android:bundle:fat` erzeugt `bin/\u003cAppName\u003e.aab` mit beiden enthaltenen ABIs. Google Play generiert daraus optimierte APKs für die jeweiligen Geräte, weshalb das Fat Bundle das richtige Artefakt für Store-Uploads ist. Für lokale Tests und Emulatortests bleiben APKs der schnellste Weg, da sich ein `.aab` nicht direkt mit `adb` installieren lässt.",
      "status": "machine-translated",
      "sourcePreview": "Google Play requires the Android App Bundle (`.aab`) format for new app submissions, and new submiss…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:08:10Z"
    },
    "b0019-text-01": {
