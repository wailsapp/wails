    "b0054-text-01": {
      "sourceHash": "ddbe45ef30c85b0c596becf60ba212bd372a1fbd6bfee69b0fecfad4f7af9066",
      "targetHash": "4ec067f15c2d4135093b7350c61115adc355bd0d3373d15afe68ef753e3c031c",
      "machineHash": "4ec067f15c2d4135093b7350c61115adc355bd0d3373d15afe68ef753e3c031c",
      "machineText": "Desktop-Code wird unter `GOOS=android` unverändert kompiliert. Aufrufe für Geometrie, Menüs und den Infobereich werden zu No-ops, da Android-Apps im Vollbildmodus ausgeführt werden.",
      "status": "final",
      "sourcePreview": "Desktop code compiles unchanged under `GOOS=android`; geometry/menu/tray calls become no-ops because…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0055-text-01": {
      "sourceHash": "d207e8644dc3c8dbe954c0e210b9d87fad076b765b122a30ad597c956f4cada3",
      "targetHash": "45eda5b39989bbdef4059616582a53048c01393459afc3ede2e25c607bff7807",
      "machineHash": "45eda5b39989bbdef4059616582a53048c01393459afc3ede2e25c607bff7807",
      "machineText": "`android` *impliziert das `linux`-Build-Tag* (Android verwendet einen Linux-Kernel): Dateien ausschließlich für Desktop-Linux benötigen `//go:build linux \u0026\u0026 !android`, und zur Laufzeit ist `runtime.GOOS` gleich `\"android\"`.",
      "status": "final",
      "sourcePreview": "`android` *implies the `linux` build tag* (Android is a Linux kernel): desktop-Linux-only files need…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0056-text-01": {
      "sourceHash": "0acc584d717da6f3cebfdbd891915eb658089910e0940599c0f9dd5224b68ff9",
      "targetHash": "e3b4076efda34026d65dbfc580b565c45146b0248d56ae11147a507e9cedea26",
      "machineHash": "e3b4076efda34026d65dbfc580b565c45146b0248d56ae11147a507e9cedea26",
      "machineText": "Ersetzen Sie Dialoge zum Speichern von Dateien und Auswählen von Verzeichnissen durch Schreibvorgänge in die App-Sandbox sowie einen Intent-basierten Freigabeablauf. Dialoge zum Öffnen von Dateien funktionieren und importieren die ausgewählten Dokumente als Kopien in das Cache-Verzeichnis, sodass Sie echte Dateisystempfade erhalten.",
      "status": "final",
      "sourcePreview": "Replace save-file and choose-directory dialogs with writes into the app sandbox plus an intent share…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
