    "b0017-text-01": {
      "sourceHash": "c63ad2f1c31e79ca4e4b0a5f391275826bf0e60b2a9ec1949723e0686b6f19d8",
      "targetHash": "a7f01b1ce9ee638535925a935e1855b2666955efe0df7307f92f4e016f84347c",
      "machineHash": "a7f01b1ce9ee638535925a935e1855b2666955efe0df7307f92f4e016f84347c",
      "machineText": "Produktions-Builds verwenden `-tags production,android`, werden von nicht benötigten Symbolen bereinigt und kompilieren die internen Diagnosefunktionen des Frameworks nicht mit ein. `wails3 task android:package:fat` erstellt sowohl `arm64-v8a` als auch `x86_64` in einer einzigen APK.",
