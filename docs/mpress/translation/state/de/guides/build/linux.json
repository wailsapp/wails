    "b0051-text-01": {
      "sourceHash": "3aa857798091c05b7f13fa78cf9e954173161f87da00630d4ec0e26104741a5a",
      "targetHash": "b6df03de157e06566c4c78fb7a470993a7319ec2398bceb85c7227a4a8883029",
      "machineHash": "b6df03de157e06566c4c78fb7a470993a7319ec2398bceb85c7227a4a8883029",
      "machineText": "Unter Linux mit proprietären NVIDIA-Treibern zeigen Wails-Apps beim Start möglicherweise ein leeres oder weißes Fenster. Ursache ist ein WebKitGTK-Fehler, bei dem der DMA-BUF-Renderer mit `gbm_bo_map()` am proprietären NVIDIA-Treiber scheitert. Betroffen sind X11 und Wayland, die Treiberversionen 377–580+ sowie GPUs der 10-Serie und ältere GT-710-Modelle.",
      "status": "machine-translated",
      "sourcePreview": "On Linux with NVIDIA proprietary drivers, Wails apps may show a blank or white window on startup. Th…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:41:15Z"
    },
