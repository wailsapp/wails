    "b0017-text-01": {
      "sourceHash": "84781f3e916189ecea0cb6dc18a593af67c9f3e1cb0bd50d19c3362e29092f17",
      "targetHash": "0400805ffafea483216688c48c6f92271dd0de0821def734de35bdd85a7f7c00",
      "machineHash": "0400805ffafea483216688c48c6f92271dd0de0821def734de35bdd85a7f7c00",
      "machineText": "Das AppImage bündelt WebKit und dessen Hilfsprozesse und patcht die gebündelte Bibliothek so, dass sie diese innerhalb des AppImage startet. Das darin enthaltene `AppRun` startet die App innerhalb des AppImage aus `usr/lib`. Dort wird der gepatchte Pfad sowohl außerhalb als auch innerhalb der bubblewrap-Sandbox von WebKit aufgelöst, sodass die Sandbox aktiviert bleibt. Stellen Sie nur dann ein eigenes `AppRun` bereit, wenn es dieses Arbeitsverzeichnis beibehält.",
      "status": "machine-translated",
      "sourcePreview": "The AppImage bundles WebKit and its helper processes, and patches the bundled library to start them …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:41:15Z"
    },
