    "b0048-text-01": {
      "sourceHash": "3aa857798091c05b7f13fa78cf9e954173161f87da00630d4ec0e26104741a5a",
      "targetHash": "f7a05ba66956f4a241baaad62d1a955441d3aa1809a4982025557ba7d9c468e9",
      "machineHash": "f7a05ba66956f4a241baaad62d1a955441d3aa1809a4982025557ba7d9c468e9",
      "machineText": "Unter Linux mit proprietären NVIDIA-Treibern zeigen Wails-Anwendungen beim Start möglicherweise ein leeres oder weißes Fenster. Ursache ist ein Fehler in WebKitGTK, durch den der DMA-BUF-Renderer mit `gbm_bo_map()` und dem proprietären NVIDIA-Treiber fehlschlägt (betrifft X11 und Wayland, die Treiberversionen 377–580+ sowie GPUs der 10-Serie und ältere GT-710-Modelle).",
      "status": "final",
      "sourcePreview": "On Linux with NVIDIA proprietary drivers, Wails apps may show a blank or white window on startup. Th…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:22Z"
    },
    "b0049-text-01": {
