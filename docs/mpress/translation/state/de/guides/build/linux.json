      "machineHash": "d046dbc31b9ee6221cf293551d6158ba18bf68f4d5688953876be160114189f3",
      "machineText": "*Wails wendet `WEBKIT_DISABLE_DMABUF_RENDERER=1` automatisch an*, wenn das NVIDIA-Kernelmodul (`/sys/module/nvidia`) erkannt wird. Daher müssen die meisten Benutzer nichts unternehmen.",
      "status": "final",
      "sourcePreview": "*Wails applies `WEBKIT_DISABLE_DMABUF_RENDERER=1` automatically* when it detects the NVIDIA kernel m…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:22Z"
