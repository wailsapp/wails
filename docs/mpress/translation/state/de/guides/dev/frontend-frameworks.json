    "b0016-text-01": {
      "sourceHash": "ebfb936b1107987c6e60a63ff64c916ed77d9cdd44ff86a53ddd1a927571de91",
      "targetHash": "2c35696909feb520b240a4d261ca0b9d3ce590e9565692abd8703a4967e956e3",
      "machineHash": "2c35696909feb520b240a4d261ca0b9d3ce590e9565692abd8703a4967e956e3",
      "machineText": "Das bedeutet nicht, dass dies Ihre einzigen Optionen sind. Das Frontend einer Wails-App ist *lediglich ein Webprojekt* – alles, was sich als statisches HTML/CSS/JS erstellen lässt, funktioniert. Wenn für das Framework Ihrer Wahl (Solid, Preact, Lit, Qwik, SvelteKit, Angular, …) keine Vorlage vorhanden ist, können Sie das Projekt in wenigen Minuten selbst erzeugen.",
      "status": "final",
      "sourcePreview": "That doesn't mean those are your only options. The frontend of a Wails app is *just a\\ web project* …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0017-heading-01": {
