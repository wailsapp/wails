      "machineHash": "060a43f96df3c3c9effdc51c2de65be2f231db67151eee8c74afaf84cc46b556",
      "machineText": "So wird das Verzeichnis `frontend/` verwendet",
      "status": "final",
      "sourcePreview": "How the `frontend/` directory is used",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
