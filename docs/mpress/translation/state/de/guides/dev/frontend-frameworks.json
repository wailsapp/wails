    "b0018-text-01": {
      "sourceHash": "8a449bb8f7b7fc6f5a19868d04e4afe3eb4e94f058df87e3b82e43fab4ac8758",
      "targetHash": "1da6fd5a8b347a66765b6cf6d62e4fd6eba33d9871950ca0d48c202e6057c3a0",
      "machineHash": "1da6fd5a8b347a66765b6cf6d62e4fd6eba33d9871950ca0d48c202e6057c3a0",
      "machineText": "Wails ist es gleichgültig, welches Framework sich in `frontend/` befindet. Es setzt lediglich einen kleinen, frameworkunabhängigen Vertrag voraus:",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0019-text-01": {
      "sourceHash": "e553627e73bba47136f29e006d9ddce93f0ff8d3c7d49a5b466b81eb4e03908f",
      "targetHash": "7d4f6ecb91fff3e75c649951e0fb70e51a7b7a506e0275a3d588e3ebdb9d8c20",
      "machineHash": "7d4f6ecb91fff3e75c649951e0fb70e51a7b7a506e0275a3d588e3ebdb9d8c20",
      "machineText": "*`frontend/dist/` wird ausgeliefert.* `main.go` bettet das erstellte Frontend mit `//go:embed all:frontend/dist` ein und stellt es über den Asset-Server bereit. Ihr Build muss ein statisches Bundle nach `frontend/dist/` ausgeben (Vites Standard-Ausgabeverzeichnis).",
      "status": "final",
      "sourcePreview": "*`frontend/dist/` is what ships.* `main.go` embeds the built frontend with `//go:embed all:frontend/…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0020-text-01": {
      "sourceHash": "85e415e7c1f9045cbb3a31fee14621a3ec827c2e4478d35a23e435edbe2913f0",
