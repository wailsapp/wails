    "b0034-text-01": {
      "sourceHash": "95bedfd964ce3f1809e6b802cdaa525e07504d3240bae0bc487497b1bcd21da8",
      "targetHash": "935a35522e64aa5e60c9fec3fc1a51b082087b7d0106b02174ebd2bc31e75082",
      "machineHash": "935a35522e64aa5e60c9fec3fc1a51b082087b7d0106b02174ebd2bc31e75082",
      "machineText": "Notch-Fenster erfordern macOS. Auf einem Mac ohne Kameragehäuse positioniert Wails\\\ndas Fenster oben mittig unterhalb der Menüleiste. Auf nicht unterstützten Plattformen\\\ngibt `NewNotchWindow` ein inaktives Handle zurück, dessen Lebenszyklusmethoden sichere\\\nNo-Ops sind und dessen `Visibility` immer false ist.",
      "status": "final",
      "sourcePreview": "Notch windows require macOS. On a Mac without a camera housing, Wails places\\ the window at the top …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
