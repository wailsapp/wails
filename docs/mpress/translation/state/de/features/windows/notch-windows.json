    "b0041-text-01": {
      "sourceHash": "601bf973640b72526ddf04767256e12b42f15dbb31a395c8957bd91a7ea8f52b",
      "targetHash": "e813b08433780754bc76d8a93bbcb7f7233ba446a5e1c475a8c4b95f7ca4b3a4",
      "machineHash": "e813b08433780754bc76d8a93bbcb7f7233ba446a5e1c475a8c4b95f7ca4b3a4",
      "machineText": "Jeder Aufruf von `NewNotchWindow` erstellt ein unabhängiges Fenster mit eigenem Inhalt,\\\neigener Sichtbarkeit und eigenem Animationszustand. Die Fenster verwenden dieselbe native Ebene, sodass die zuletzt\\\nangezeigte oder mit dem Zeiger betretene Instanz im Vordergrund erscheint und frühere\\\nInstanzen überlagern kann. Wenn Fenster unterschiedliche Bildschirme verwenden, wird jedes mittig am\\\nKameragehäuse des jeweiligen Bildschirms ausgerichtet. macOS koordiniert keine Notch-Fenster verschiedener\\\nAnwendungen. Wenn separate Anwendungen Fenster an derselben Position und auf\\\nderselben Ebene anzeigen, erscheint das zuletzt angeordnete Fenster im Vordergrund.",
      "status": "final",
      "sourcePreview": "Each `NewNotchWindow` call creates an independent window with its own content,\\ visibility, and anim…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:22Z"
    },
    "b0042-text-01": {
