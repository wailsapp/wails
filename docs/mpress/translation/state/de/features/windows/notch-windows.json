    "b0001-text-01": {
      "sourceHash": "cca166bb456e03ca3f435d24321e9a38f2d9614960f564ac1a5cdcd61fdf5669",
      "targetHash": "d49f5854a0080a3e2e9549179d861588935f7b1f2b8a82593c109582493b842b",
      "machineHash": "d49f5854a0080a3e2e9549179d861588935f7b1f2b8a82593c109582493b842b",
      "machineText": "`NewNotchWindow` erstellt ein geformtes, nicht aktivierendes macOS-Panel, das am\\\nKameragehäuse angedockt ist. Wails steuert die native Positionierung, die schwarzen seitlichen\\\nAnsätze, die transparente äußere Zeichenfläche, die Fensterebene, das Verhalten in Spaces sowie\\\noptionale Ein- und Ausblendeanimationen. Ihre Webinhalte belegen nur das angeforderte innere Rechteck.\\\nWenn Sie den Zeiger in das Fenster bewegen, wird dessen Webview sofort zum Key-Window, ohne\\\ndie Anwendung zu aktivieren.",
      "status": "final",
      "sourcePreview": "`NewNotchWindow` creates a shaped, non-activating macOS panel attached to the\\ camera housing. Wails…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:22Z"
    },
    "b0002-text-01": {
