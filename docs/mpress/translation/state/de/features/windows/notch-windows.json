      "targetHash": "12ad890e14cc62ad285a3a37827e4cce71c5672b9dfe669a1054f8d4eecb1d07",
      "machineHash": "12ad890e14cc62ad285a3a37827e4cce71c5672b9dfe669a1054f8d4eecb1d07",
      "machineText": "Für Benachrichtigungen verwenden Anwendungen häufig ein ausgeblendetes Fenster erneut oder\\\nverwalten eine eigene Warteschlange in einer Webview. Wails erzwingt weder eine Warteschlange\\\nnoch Ersetzung, automatisches Schließen oder eine Einzelfenster-Richtlinie.",
      "status": "final",
      "sourcePreview": "For notification workloads, applications commonly reuse a hidden window or\\ maintain their own queue…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:22Z"
    },
