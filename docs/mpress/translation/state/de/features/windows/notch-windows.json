    "b0037-text-01": {
      "sourceHash": "ad98b2264d00caa78b81472f29f638c65e90b6cf6f4ca17847b7f900dddab4e1",
      "targetHash": "e23970fae4742897caf4dc59fe268e31e48f1476999f26eb3313744a528fb7f9",
      "machineHash": "e23970fae4742897caf4dc59fe268e31e48f1476999f26eb3313744a528fb7f9",
      "machineText": "`Hide` lässt das Fenster zur Wiederverwendung bestehen. Bei aktivierter Animation gleitet es zurück über den Bildschirmrand, bevor es aus der Anzeigereihenfolge entfernt wird. Webview, JavaScript-Zustand, Bindings und Event-Listener bleiben geladen, aber das ausgeblendete Fenster bietet kein Hover-Ziel. Die Anwendung muss `Show` aufrufen, um es wieder einzublenden.",
      "status": "final",
      "sourcePreview": "`Hide` keeps the window alive for reuse. With animation enabled, it slides back above the display be…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
