    "b0004-text-01": {
      "sourceHash": "7d1ecd1f084733419a78b06a0c02f89cdf223d4c7fb04f24bae725580e28ff0f",
      "targetHash": "6f34ef2bbe47930d1d2fc00ec5d5653283acee5939b0770427bdffe94fd96295",
      "machineHash": "6f34ef2bbe47930d1d2fc00ec5d5653283acee5939b0770427bdffe94fd96295",
      "machineText": "Mit Wails v3 können Sie mehrere Fenster innerhalb einer einzigen Anwendung erstellen und verwalten. Dadurch lassen sich komplexere und vielseitigere Benutzeroberflächen entwickeln, die über die Einschränkungen von Anwendungen mit nur einem Fenster hinausgehen.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces the ability to create and manage multiple windows within a\\ single application. …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0005-text-01": {
      "sourceHash": "34b6425086cc6a8c77ed211279c651c5f89db9cc9574b2cfb827a6bea7d7edb0",
      "targetHash": "5cfc03809cfcadc3a7323b987fe1a57293b6e95dd1ed68ea19f483e0ffb71940",
      "machineHash": "5cfc03809cfcadc3a7323b987fe1a57293b6e95dd1ed68ea19f483e0ffb71940",
      "machineText": "Jedes Fenster kann unabhängig konfiguriert werden. Größe, Position, Inhalt und Verhalten lassen sich flexibel festlegen. So können Anwendungen separate Fenster für unterschiedliche Funktionen bereitstellen, etwa Hauptoberflächen, Einstellungsbereiche oder ergänzende Ansichten.",
      "status": "final",
      "sourcePreview": "Each window can be independently configured, providing flexibility in terms of\\ size, position, cont…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0006-text-01": {
      "sourceHash": "8a62723601fbd79ef9323a585693e97cef3d6f85d55b7d7096c022411c6ddbbb",
      "targetHash": "4d5c26353ca219f0c163ad05c53d88d5ece84c7c0c77c5e3120092d773412500",
      "machineHash": "4d5c26353ca219f0c163ad05c53d88d5ece84c7c0c77c5e3120092d773412500",
      "machineText": "Entwickler können diese Fenster programmgesteuert erstellen, bearbeiten und verwalten. Dadurch entstehen dynamische Benutzeroberflächen, die sich an die Anforderungen der Benutzer und den Zustand der Anwendung anpassen.",
      "status": "final",
      "sourcePreview": "Developers can create, manipulate, and manage these windows programmatically,\\ allowing for dynamic …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0007-heading-01": {
      "sourceHash": "90c7844e5ce6a8838322b75b3d78aad465958c9987df0a3c78a43cf82ca51290",
      "targetHash": "7000caf5738f3fca55a29820c877e8838bb61f4f0fd70e89feaae28f732e3bf0",
      "machineHash": "7000caf5738f3fca55a29820c877e8838bb61f4f0fd70e89feaae28f732e3bf0",
      "machineText": "Systemleistenintegration",
      "status": "final",
      "sourcePreview": "System Tray Integration",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0008-text-01": {
      "sourceHash": "812dba13be1f1fa5514a4cca9d77f926e5a956107d7988d05b9b1dd37ba1dc40",
      "targetHash": "a75f029286cf50ab4febc276b603dcdaeae90b4599a39793f0134ae02252221d",
      "machineHash": "a75f029286cf50ab4febc276b603dcdaeae90b4599a39793f0134ae02252221d",
      "machineText": "Wails v3 bietet umfassende Unterstützung für Funktionen der Systemleiste, sodass Ihre Anwendung dauerhaft auf dem Desktop des Benutzers verfügbar bleibt. Diese Funktion ist besonders für Anwendungen nützlich, die im Hintergrund ausgeführt werden müssen oder schnellen Zugriff auf zentrale Funktionen bieten sollen.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces robust support for system tray functionality, allowing your\\ application to main…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0009-text-01": {
      "sourceHash": "7c3f7d8692501289caf2dce27685e8b2928b4a0b7b44947051cbd7b1ead70743",
      "targetHash": "ea3a47433d551c9783211376f43b72f8fec8691fcbfbec60b3fbff9a5b450025",
      "machineHash": "ea3a47433d551c9783211376f43b72f8fec8691fcbfbec60b3fbff9a5b450025",
      "machineText": "Die Systemleistenintegration von Wails v3 bietet unter anderem folgende Hauptfunktionen:",
      "status": "final",
      "sourcePreview": "Key features of the Wails v3 system tray integration include:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0010-text-01": {
      "sourceHash": "dedec9bcc95b13e7903f3318a8f656c684ce2ef9442d517a6d61c0f6fed86341",
      "targetHash": "de7575ec290d4e2d4ad69ea42efb7a5b6b5e5a2ef71e44e71b6420163734ceb8",
      "machineHash": "de7575ec290d4e2d4ad69ea42efb7a5b6b5e5a2ef71e44e71b6420163734ceb8",
      "machineText": "Fensterzuordnung: Sie können dem Symbol in der Systemleiste ein Fenster zuordnen. Bei der Aktivierung wird dieses Fenster relativ zur Position des Symbols zentriert und ermöglicht so einen schnellen Zugriff auf Ihre Anwendung.",
      "status": "final",
      "sourcePreview": "Window Attachment: You can associate a window with the system tray icon. When activated, this window…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0011-text-01": {
      "sourceHash": "c2ac5f848de9266216c12bfe9678ae18c7ad7be6ffd44d47fae52707143afcf3",
      "targetHash": "30fc53270fadf779539aa8219607d700f019651a3ddedf69e38fdb21e87712ee",
      "machineHash": "30fc53270fadf779539aa8219607d700f019651a3ddedf69e38fdb21e87712ee",
      "machineText": "Umfassende Menüunterstützung: Erstellen Sie umfangreiche interaktive Menüs, auf die Benutzer direkt über das Symbol in der Systemleiste zugreifen können. So lassen sich schnelle Aktionen ausführen, ohne das vollständige Anwendungsfenster öffnen zu müssen.",
      "status": "final",
      "sourcePreview": "Comprehensive Menu Support: Create rich, interactive menus that users can access directly from the s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0012-text-01": {
      "sourceHash": "658ceb4bb27d5ead74c07762c0f35c20944272d46936abb25817a6e31adada0f",
      "targetHash": "c03726021f842a17684ce863330505adc5d6ba6807c9001494258ffcd1d1e68b",
      "machineHash": "c03726021f842a17684ce863330505adc5d6ba6807c9001494258ffcd1d1e68b",
      "machineText": "Adaptive Symboldarstellung: Die Unterstützung für Symbole im hellen und dunklen Modus stellt sicher, dass das Systemleistensymbol Ihrer Anwendung bei verschiedenen Systemdesigns sichtbar und ansprechend bleibt. Unter macOS werden außerdem Vorlagensymbole unterstützt.",
      "status": "final",
      "sourcePreview": "Adaptive Icon Display: Support for both light and dark mode icons ensures your application's system …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0013-heading-01": {
      "sourceHash": "5a7e46316522863bcbdf3cf0e140bbb7f1aa98f04f19bcb15541814acbc84753",
      "targetHash": "dd2ba416ad4250c09f99f818c4a5e25d580ecad7bbe727fd5c74beec143fdb1f",
      "machineHash": "dd2ba416ad4250c09f99f818c4a5e25d580ecad7bbe727fd5c74beec143fdb1f",
      "machineText": "Verbesserte Bindings-Generierung",
