    "b0014-text-01": {
      "sourceHash": "8fb41de9280116fc966305d32ddf032f540af11a632f6d6c34eb5d67fd339156",
      "targetHash": "a2ba01569b7d051c0cc93094c50ff2bbce0099cea44d578d837478d0bad83b68",
      "machineHash": "a2ba01569b7d051c0cc93094c50ff2bbce0099cea44d578d837478d0bad83b68",
      "machineText": "Wails v3 verbessert die Generierung von Bindings für Ihr Projekt erheblich. Bindings verbinden Ihr Go-Backend mit Ihrem Frontend und ermöglichen eine nahtlose Kommunikation zwischen beiden.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces a significant improvement in how bindings are generated for\\ your project. Bindi…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0015-text-01": {
      "sourceHash": "a795b3e9be5ab858f12279f513590db76d6fa5a3e7e708cb4254c8b19e4ba8c3",
      "targetHash": "aab9a1fbe1fd47f37517ff1944542530fdd37a08c93eb4f2531b6e19e1949efd",
      "machineHash": "aab9a1fbe1fd47f37517ff1944542530fdd37a08c93eb4f2531b6e19e1949efd",
      "machineText": "Die Bindings werden jetzt mit einem leistungsfähigen statischen Analysewerkzeug generiert, das den Generierungsprozess grundlegend verbessert. Es erhöht die Geschwindigkeit und bewahrt die Codequalität, indem Kommentare und Parameternamen erhalten bleiben.",
      "status": "final",
      "sourcePreview": "Binding generation is now done using a sophisticated static analyzer that\\ radically improves the bi…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0016-text-01": {
      "sourceHash": "178402d55136823be2520028abe6a4caf6ad778708f466da6e732aaf2fc70feb",
      "targetHash": "9411b84d2b271a3838cead05bc2f01aa86c2e1cdc5ce3e7c832c0c0163d171fe",
