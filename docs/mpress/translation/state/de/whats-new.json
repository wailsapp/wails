    "b0001-text-01": {
      "sourceHash": "44479da91d327a99d03a59ecd05a869c26846bcf93c03e8dc6243a360961da4d",
      "targetHash": "03716ee45b035f6b2db1359857bb1ee4cadc37bb73e549b4bad20aa3a4a4287c",
      "machineHash": "03716ee45b035f6b2db1359857bb1ee4cadc37bb73e549b4bad20aa3a4a4287c",
      "machineText": "Wails v3 bringt gegenüber v2 wesentliche Änderungen mit sich. Die deklarative API für ein einzelnes Fenster wird durch einen flexibleren prozeduralen Ansatz ersetzt. Dieses neue API-Design verbessert die Lesbarkeit des Codes und vereinfacht die Entwicklung, insbesondere bei komplexen Anwendungen mit mehreren Fenstern.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces significant changes from v2. It replaces the\\ single-window, declarative API wit…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0002-text-01": {
      "sourceHash": "97c252aca10ec764355d68d945df86e9e1c3cfea84c0d5539e8e58e819f750d3",
      "targetHash": "ff9ac00c95be1d4d807bd6aff2afc52d4888742bd15cf8f539ca7cde2ea89c9e",
      "machineHash": "ff9ac00c95be1d4d807bd6aff2afc52d4888742bd15cf8f539ca7cde2ea89c9e",
      "machineText": "Wails v3 stellt eine bedeutende Weiterentwicklung beim Erstellen von Desktopanwendungen mit Go und Webtechnologien dar.",
      "status": "final",
      "sourcePreview": "Wails v3 represents a substantial evolution in how desktop applications\\ can be built using Go and w…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:24Z"
    },
    "b0003-heading-01": {
      "sourceHash": "6b1c4bb89a4b9bc269d9c50d3c1691788021f31eb006464f760b3583d68094c5",
