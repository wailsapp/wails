    "b0020-text-01": {
      "sourceHash": "48d705d794419374c335c65cac7cef32f970e4174656dff05fe94f8c693f30ab",
      "targetHash": "0ce5974a44c6671ca8671a45cbf14236563d5323b23c0dbd694971ea7ef6f4c6",
      "machineHash": "0ce5974a44c6671ca8671a45cbf14236563d5323b23c0dbd694971ea7ef6f4c6",
      "machineText": "Übergeben Sie Ihrer Anwendungskonfiguration einfach ein einzelnes `embed.FS`, das alle Ihre Assets enthält. Sie müssen sich nicht einmal im obersten Verzeichnis befinden – Wails findet selbst heraus, wo sie liegen.",
      "status": "final",
      "sourcePreview": "You just pass a single `embed.FS` that contains all your assets into your\\ application configuration…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
