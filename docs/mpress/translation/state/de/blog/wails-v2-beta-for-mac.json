    "b0022-text-01": {
      "sourceHash": "c50dbd61000abcb691a783a0fc0d1fd3ec9aad8579587f13df6e09d51ab27578",
      "targetHash": "75621b2420a34c835032532ad74fb49a9dbfb84e7f5520e1dbb452c6ecc2ace9",
      "machineHash": "75621b2420a34c835032532ad74fb49a9dbfb84e7f5520e1dbb452c6ecc2ace9",
      "machineText": "Da Assets nun nicht mehr gebündelt werden müssen, eröffnet sich eine völlig neue Entwicklungserfahrung. Der neue Befehl `wails dev` erstellt und startet Ihre Anwendung, lädt die Assets jedoch direkt vom Datenträger, anstatt die Assets im `embed.FS` zu verwenden.",
      "status": "final",
      "sourcePreview": "Now that assets don't need to be bundled, it's enabled a whole new development\\ experience. The new …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:20Z"
