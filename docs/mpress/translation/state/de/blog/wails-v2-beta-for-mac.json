      "targetHash": "a6b6aeaee9ca43068127fe6320bd02597f233c01c0962177cb8ce5958d1c4efd",
      "machineHash": "a6b6aeaee9ca43068127fe6320bd02597f233c01c0962177cb8ce5958d1c4efd",
      "machineText": "Darüber hinaus bietet er folgende Funktionen:",
