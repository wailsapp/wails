    "b0026-text-01": {
      "sourceHash": "f197c0f9e5f5cf10e17ca7feff17b0cd8f0e4c598847e9fc5e008e7e913bd1c2",
      "targetHash": "eaa4cb95f09e74e5fcc12ed6bd95b55842d0dcf5d7073839f17d8b33ef707625",
      "machineHash": "eaa4cb95f09e74e5fcc12ed6bd95b55842d0dcf5d7073839f17d8b33ef707625",
      "machineText": "Zusätzlich wird auf Port 34115 ein Webserver gestartet. Dieser stellt Ihre Anwendung jedem Browser bereit, der eine Verbindung zu ihm herstellt. Alle verbundenen Webbrowser reagieren auf Systemereignisse wie Hot Reload nach einer Asset-Änderung.",
      "status": "final",
      "sourcePreview": "In addition to this, a webserver will start on port 34115. This will serve your\\ application to any …",
      "provider": "codex",
