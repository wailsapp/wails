      "machineText": "Dein Sponsoring hilft dabei, das Projekt zu pflegen, die Dokumentation zu verbessern und neue Funktionen zu entwickeln, von denen die gesamte Community profitiert.",
      "status": "final",
      "sourcePreview": "Your sponsorship helps maintain the project, improve documentation, and develop new features that be…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
