      "machineHash": "1cb87930b405b68a7ebb6e5a01d85aebe52d283bcce8b87cd9ff8a393ae0bc50",
      "machineText": "Wails ist kostenlos, quelloffen und wird von Entwicklern für Entwickler entwickelt. Wenn Wails dir hilft, beeindruckende Anwendungen zu entwickeln, erwäge, die weitere Entwicklung zu unterstützen.",
      "status": "final",
      "sourcePreview": "Wails is free and open source, built by developers for developers. If Wails helps you build amazing …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
