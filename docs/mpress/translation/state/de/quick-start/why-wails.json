    "b0044-text-01": {
      "sourceHash": "afcd533e41e74c149172788f4601c8a87901e5d91fa0f2d7ce604d141aa59370",
      "targetHash": "449804e6075232eb6e66b551164e0cf01866c1b8c660d26db543d90334010248",
      "machineHash": "449804e6075232eb6e66b551164e0cf01866c1b8c660d26db543d90334010248",
      "machineText": "Anders als Electron, das einen vollständigen Browser und die Node.js-Laufzeit bündelt, verfolgt Wails einen grundlegend anderen Ansatz: Ihr Go-Code wird zu einer nativen Binärdatei kompiliert, während Ihre Benutzeroberfläche in der integrierten WebView des Betriebssystems ausgeführt wird. Diese Architektur sorgt für die kleinen Binärdateien, den schnellen Start und den geringen Arbeitsspeicherbedarf, durch die sich Wails-Anwendungen nativ anfühlen.",
      "status": "final",
      "sourcePreview": "Unlike Electron which bundles an entire browser and Node.js runtime, Wails takes a fundamentally dif…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
