      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:23Z"
    },
    "b0046-text-01": {
      "sourceHash": "bb8c4ab52ae79ed5a72130bcff12e02cae226b471acaaa1458a5ee29904b9c77",
