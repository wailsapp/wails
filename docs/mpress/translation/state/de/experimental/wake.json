      "machineHash": "147ddb13e207e8720c48e3d659b1af2f4b50e26d2fe26c7c23a21f1e85892090",
      "machineText": "`env` und `vars` werden *schlüsselweise zusammengeführt*; bei Konflikten hat die Überschreibung Vorrang.",
      "status": "final",
      "sourcePreview": "`env` and `vars` *merge per key*, with the override winning on collisions.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
