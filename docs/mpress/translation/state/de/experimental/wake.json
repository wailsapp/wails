      "machineHash": "d487035fcf253a3a72182120ce829a51e2809a69e0e3cac59a161e186feff728",
      "machineText": "Ein Task, der *nur* in einer Überschreibungsdatei vorhanden ist, wird *hinzugefügt*.",
      "status": "final",
      "sourcePreview": "A task that exists *only* in an override file is *added*.",
