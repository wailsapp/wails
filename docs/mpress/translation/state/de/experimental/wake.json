    "b0029-text-01": {
      "sourceHash": "cf845163f68c4801cb6daeea427d279b43ae53a452f659052e65868e1971d643",
      "targetHash": "8d2920add825bad84e2db58c7c1d2cd6b7ad77b100ca6c601cb87be440a54147",
      "machineHash": "8d2920add825bad84e2db58c7c1d2cd6b7ad77b100ca6c601cb87be440a54147",
      "machineText": "Ein Task mit *demselben Namen* überschreibt den Basis-Task. Listenfelder (`cmds`, `deps`, `sources`, `generates`, `platforms`, `status`, `preconditions`, `aliases`) *ersetzen* die entsprechenden Felder der Basis, wenn die Überschreibung sie angibt. Felder, die in der Überschreibung fehlen, werden aus der Basis übernommen.",
      "status": "final",
      "sourcePreview": "A task with the *same name* overrides the base task. List fields (`cmds`, `deps`, `sources`, `genera…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:21Z"
    },
    "b0030-text-01": {
      "sourceHash": "2e6c81f509162acc33e81a9c9db6ac2e6fca3400db59c5081d7be4fc792bfde0",
