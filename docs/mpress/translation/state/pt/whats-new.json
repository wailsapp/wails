      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0010-text-01": {
      "sourceHash": "dedec9bcc95b13e7903f3318a8f656c684ce2ef9442d517a6d61c0f6fed86341",
      "targetHash": "83da2ec90187da68dfafab4cfbc8cd9168e536017af86d62bed83f0b8b5b66ce",
      "machineHash": "83da2ec90187da68dfafab4cfbc8cd9168e536017af86d62bed83f0b8b5b66ce",
      "machineText": "Vinculação de janela: você pode associar uma janela ao ícone da bandeja do sistema. Quando ativada, essa janela será centralizada em relação à posição do ícone, oferecendo uma ótima maneira de acessar rapidamente sua aplicação.",
      "status": "final",
      "sourcePreview": "Window Attachment: You can associate a window with the system tray icon. When activated, this window…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0011-text-01": {
      "sourceHash": "c2ac5f848de9266216c12bfe9678ae18c7ad7be6ffd44d47fae52707143afcf3",
      "targetHash": "5d67b18b72cd26ae834ae96180b34716f5e7f2a9a47f5f54dac8e608aaeefccb",
      "machineHash": "5d67b18b72cd26ae834ae96180b34716f5e7f2a9a47f5f54dac8e608aaeefccb",
      "machineText": "Suporte completo a menus: crie menus avançados e interativos que os usuários possam acessar diretamente pelo ícone da bandeja do sistema. Isso permite executar ações rápidas sem precisar abrir a janela completa da aplicação.",
      "status": "final",
      "sourcePreview": "Comprehensive Menu Support: Create rich, interactive menus that users can access directly from the s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0012-text-01": {
      "sourceHash": "658ceb4bb27d5ead74c07762c0f35c20944272d46936abb25817a6e31adada0f",
      "targetHash": "12bb452a082a5203eb78ad8908fe2a30e61110f7664bfbc3db0afc90c2993d45",
      "machineHash": "12bb452a082a5203eb78ad8908fe2a30e61110f7664bfbc3db0afc90c2993d45",
      "machineText": "Exibição adaptável de ícones: o suporte a ícones para os modos claro e escuro garante que o ícone da sua aplicação na bandeja do sistema permaneça visível e esteticamente agradável em diferentes temas do sistema. A integração também oferece suporte a ícones de modelo no macOS.",
      "status": "final",
      "sourcePreview": "Adaptive Icon Display: Support for both light and dark mode icons ensures your application's system …",
      "provider": "codex",
      "model": "gpt-6-astra",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
