    "b0008-text-01": {
      "sourceHash": "812dba13be1f1fa5514a4cca9d77f926e5a956107d7988d05b9b1dd37ba1dc40",
      "targetHash": "0c2bacddcf490392a4e5ae329396e6c21e4a7748ec8a941b1d63c9b95904a4de",
      "machineHash": "0c2bacddcf490392a4e5ae329396e6c21e4a7748ec8a941b1d63c9b95904a4de",
      "machineText": "O Wails v3 introduz suporte robusto aos recursos da bandeja do sistema, permitindo que sua aplicação mantenha uma presença constante na área de trabalho do usuário. Esse recurso é particularmente útil para aplicações que precisam ser executadas em segundo plano ou oferecer acesso rápido a funções essenciais.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces robust support for system tray functionality, allowing your\\ application to main…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
