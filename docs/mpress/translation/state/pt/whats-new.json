    "b0004-text-01": {
      "sourceHash": "7d1ecd1f084733419a78b06a0c02f89cdf223d4c7fb04f24bae725580e28ff0f",
      "targetHash": "d1cf0e20b8ae349f0d5fa9866c8f0edb5c44d074c005b5bcc9e6b23ed925085e",
      "machineHash": "d1cf0e20b8ae349f0d5fa9866c8f0edb5c44d074c005b5bcc9e6b23ed925085e",
      "machineText": "O Wails v3 introduz a capacidade de criar e gerenciar várias janelas em uma única aplicação. Esse recurso permite que os desenvolvedores criem interfaces de usuário mais complexas e versáteis, superando as limitações das aplicações de janela única.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces the ability to create and manage multiple windows within a\\ single application. …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0005-text-01": {
      "sourceHash": "34b6425086cc6a8c77ed211279c651c5f89db9cc9574b2cfb827a6bea7d7edb0",
      "targetHash": "141efa7c4197b089b4cc4c3ab61ec7ecf898a2c5563c5187595b777acfb07ffe",
      "machineHash": "141efa7c4197b089b4cc4c3ab61ec7ecf898a2c5563c5187595b777acfb07ffe",
      "machineText": "Cada janela pode ser configurada de forma independente, oferecendo flexibilidade de tamanho, posição, conteúdo e comportamento. Isso permite criar aplicações com janelas separadas para diferentes funcionalidades, como interfaces principais, painéis de configurações ou visualizações auxiliares.",
      "status": "final",
      "sourcePreview": "Each window can be independently configured, providing flexibility in terms of\\ size, position, cont…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0006-text-01": {
      "sourceHash": "8a62723601fbd79ef9323a585693e97cef3d6f85d55b7d7096c022411c6ddbbb",
      "targetHash": "9ef88bfb9c9788206bda93ce5a0faa16415cc108899947e8c3ec4d07b1c981aa",
      "machineHash": "9ef88bfb9c9788206bda93ce5a0faa16415cc108899947e8c3ec4d07b1c981aa",
      "machineText": "Os desenvolvedores podem criar, manipular e gerenciar essas janelas por meio de código, possibilitando interfaces de usuário dinâmicas que se adaptam às necessidades do usuário e aos estados da aplicação.",
      "status": "final",
      "sourcePreview": "Developers can create, manipulate, and manage these windows programmatically,\\ allowing for dynamic …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
