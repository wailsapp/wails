    "b0001-text-01": {
      "sourceHash": "44479da91d327a99d03a59ecd05a869c26846bcf93c03e8dc6243a360961da4d",
      "targetHash": "1205b38a5e87bdd176495ebffd6507f866859a688094030d5083fb82a07c78ac",
      "machineHash": "1205b38a5e87bdd176495ebffd6507f866859a688094030d5083fb82a07c78ac",
      "machineText": "O Wails v3 introduz mudanças significativas em relação ao v2. Ele substitui a API declarativa de janela única por uma abordagem procedural mais flexível. Esse novo design de API melhora a legibilidade do código e simplifica o desenvolvimento, especialmente para aplicações complexas com várias janelas.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces significant changes from v2. It replaces the\\ single-window, declarative API wit…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
    "b0002-text-01": {
      "sourceHash": "97c252aca10ec764355d68d945df86e9e1c3cfea84c0d5539e8e58e819f750d3",
