    "b0044-text-01": {
      "sourceHash": "afcd533e41e74c149172788f4601c8a87901e5d91fa0f2d7ce604d141aa59370",
      "targetHash": "a529f7967a979872bb091ffa37e5e0d29816a091109d1c7e1702181f1e1e164a",
      "machineHash": "a529f7967a979872bb091ffa37e5e0d29816a091109d1c7e1702181f1e1e164a",
      "machineText": "Ao contrário do Electron, que inclui um navegador completo e o runtime do Node.js, o Wails adota uma abordagem fundamentalmente diferente: seu código Go é compilado em um binário nativo, e sua interface é executada na WebView integrada ao sistema operacional. Essa arquitetura proporciona binários pequenos, inicialização rápida e baixo consumo de memória, fazendo com que os aplicativos Wails tenham uma experiência nativa.",
      "status": "final",
      "sourcePreview": "Unlike Electron which bundles an entire browser and Node.js runtime, Wails takes a fundamentally dif…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
