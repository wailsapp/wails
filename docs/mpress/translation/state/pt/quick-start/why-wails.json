      "machineHash": "4eb9cdf78f9b25c50775c105af173fd48816530b37f7ff4a97eef8b849e7a796",
      "machineText": "Essa arquitetura simples permite que o código JavaScript chame funções Go diretamente (por meio de bindings gerados automaticamente), enquanto o Go pode enviar eventos e dados de volta ao frontend. As duas camadas se comunicam por uma ponte eficiente em memória, com sobrecarga inferior a um milissegundo.",
      "status": "final",
      "sourcePreview": "This simple architecture enables JavaScript code to call Go functions directly (through auto-generat…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:43Z"
    },
