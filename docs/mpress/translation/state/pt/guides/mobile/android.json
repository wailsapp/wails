    "b0055-text-01": {
      "sourceHash": "d207e8644dc3c8dbe954c0e210b9d87fad076b765b122a30ad597c956f4cada3",
      "targetHash": "75ae29c913c9549b5fa1f87da5f8a4c90f46abbc1e425e13567ef07694776be4",
      "machineHash": "75ae29c913c9549b5fa1f87da5f8a4c90f46abbc1e425e13567ef07694776be4",
      "machineText": "`android` *implica a tag de compilação `linux`* (o Android usa um kernel Linux): arquivos exclusivos do Linux para desktop precisam de `//go:build linux \u0026\u0026 !android` e, em tempo de execução, `runtime.GOOS` é `\"android\"`.",
      "status": "final",
      "sourcePreview": "`android` *implies the `linux` build tag* (Android is a Linux kernel): desktop-Linux-only files need…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
    },
    "b0056-text-01": {
      "sourceHash": "0acc584d717da6f3cebfdbd891915eb658089910e0940599c0f9dd5224b68ff9",
      "targetHash": "cfd2080f8d2346181f74eda31904aa374d2f84d99ce7d1f4fbc821d8bd3df724",
      "machineHash": "cfd2080f8d2346181f74eda31904aa374d2f84d99ce7d1f4fbc821d8bd3df724",
      "machineText": "Substitua as caixas de diálogo para salvar arquivos e escolher diretórios por gravações no sandbox do aplicativo, combinadas com um fluxo de compartilhamento por intent. As caixas de diálogo para abrir arquivos funcionam e importam os documentos escolhidos como cópias no diretório de cache, portanto você obtém caminhos reais do sistema de arquivos.",
      "status": "final",
      "sourcePreview": "Replace save-file and choose-directory dialogs with writes into the app sandbox plus an intent share…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
