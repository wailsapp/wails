    "b0054-text-01": {
      "sourceHash": "ddbe45ef30c85b0c596becf60ba212bd372a1fbd6bfee69b0fecfad4f7af9066",
      "targetHash": "15adb9bfe871e5c40d9519b59d9e73e12d6d6654da007390e993125abdb79e0c",
      "machineHash": "15adb9bfe871e5c40d9519b59d9e73e12d6d6654da007390e993125abdb79e0c",
      "machineText": "O código para desktop é compilado sem alterações com `GOOS=android`; as chamadas de geometria, menu e bandeja não executam nenhuma operação porque os aplicativos Android funcionam em tela cheia.",
      "status": "final",
      "sourcePreview": "Desktop code compiles unchanged under `GOOS=android`; geometry/menu/tray calls become no-ops because…",
      "provider": "codex",
