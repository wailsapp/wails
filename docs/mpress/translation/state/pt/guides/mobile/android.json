    "b0055-text-01": {
      "sourceHash": "ea3ebeb260f9a9411b83ff115afdf72c91772a5fba327540342c06397df2aef9",
      "targetHash": "cc17a22238d2008361db2c1c1b37076921403171771a6ad0e05780bdb48f6278",
      "machineHash": "cc17a22238d2008361db2c1c1b37076921403171771a6ad0e05780bdb48f6278",
      "machineText": "`android` **implica a tag de compilação `linux`** (o Android usa um kernel Linux): arquivos exclusivos do Linux para desktop precisam de `//go:build linux \u0026\u0026 !android` e, em tempo de execução, `runtime.GOOS` é `\"android\"`.",
      "status": "machine-translated",
      "sourcePreview": "`android` **implies the `linux` build tag** (Android is a Linux kernel): desktop-Linux-only files ne…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:08:14Z"
    },
    "b0056-text-01": {
      "sourceHash": "0acc584d717da6f3cebfdbd891915eb658089910e0940599c0f9dd5224b68ff9",
      "targetHash": "1934b0b8161defd85378e85de9a0e2821797628d90ebf700ea36e70366569386",
      "machineHash": "1934b0b8161defd85378e85de9a0e2821797628d90ebf700ea36e70366569386",
      "machineText": "Substitua as caixas de diálogo para salvar arquivos e escolher diretórios por gravações no sandbox do aplicativo, acompanhadas de um fluxo de compartilhamento por intent. As caixas de diálogo para abrir arquivos funcionam e importam os documentos escolhidos como cópias no diretório de cache, fornecendo caminhos reais do sistema de arquivos.",
      "status": "machine-translated",
      "sourcePreview": "Replace save-file and choose-directory dialogs with writes into the app sandbox plus an intent share…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
