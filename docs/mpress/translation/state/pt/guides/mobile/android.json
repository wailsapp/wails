    "b0054-text-01": {
      "sourceHash": "ddbe45ef30c85b0c596becf60ba212bd372a1fbd6bfee69b0fecfad4f7af9066",
      "targetHash": "51a07619d643de1ce783ff3a9b12ab5b93465d8669982000c962b154f836d598",
      "machineHash": "51a07619d643de1ce783ff3a9b12ab5b93465d8669982000c962b154f836d598",
      "machineText": "O código para desktop é compilado sem alterações com `GOOS=android`; as chamadas de geometria, menu e bandeja tornam-se operações inativas porque os aplicativos Android são executados em tela cheia.",
      "status": "machine-translated",
      "sourcePreview": "Desktop code compiles unchanged under `GOOS=android`; geometry/menu/tray calls become no-ops because…",
      "provider": "codex",
