    "b0018-text-01": {
      "sourceHash": "8a449bb8f7b7fc6f5a19868d04e4afe3eb4e94f058df87e3b82e43fab4ac8758",
      "targetHash": "91b1e7c00711dbd7de5bcc097c5aab7d70a7a963ca3914660feec68de08f63c4",
      "machineHash": "91b1e7c00711dbd7de5bcc097c5aab7d70a7a963ca3914660feec68de08f63c4",
      "machineText": "Para o Wails, não importa qual framework esteja em `frontend/`. Ele depende apenas de um contrato pequeno e independente de framework:",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
    },
    "b0019-text-01": {
      "sourceHash": "e553627e73bba47136f29e006d9ddce93f0ff8d3c7d49a5b466b81eb4e03908f",
      "targetHash": "7487f7e9536550c75b16ec2eb94a2136b5ca9657c80cd7cc07b7f4deebc48771",
      "machineHash": "7487f7e9536550c75b16ec2eb94a2136b5ca9657c80cd7cc07b7f4deebc48771",
      "machineText": "*`frontend/dist/` é o que será distribuído.* `main.go` incorpora o frontend compilado com `//go:embed all:frontend/dist` e o disponibiliza pelo servidor de ativos. Sua compilação deve gerar um pacote estático em `frontend/dist/` (o diretório de saída padrão do Vite).",
      "status": "final",
      "sourcePreview": "*`frontend/dist/` is what ships.* `main.go` embeds the built frontend with `//go:embed all:frontend/…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
    },
    "b0020-text-01": {
      "sourceHash": "85e415e7c1f9045cbb3a31fee14621a3ec827c2e4478d35a23e435edbe2913f0",
