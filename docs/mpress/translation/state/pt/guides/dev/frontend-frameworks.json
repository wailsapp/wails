    "b0016-text-01": {
      "sourceHash": "ebfb936b1107987c6e60a63ff64c916ed77d9cdd44ff86a53ddd1a927571de91",
      "targetHash": "a382750f170c63b17dcf4ff9e02da76c314591fa2762a03407b804f6614cb182",
      "machineHash": "a382750f170c63b17dcf4ff9e02da76c314591fa2762a03407b804f6614cb182",
      "machineText": "Isso não significa que essas sejam suas únicas opções. O frontend de um aplicativo Wails é *apenas um projeto web* — qualquer projeto que gere HTML/CSS/JS estático funcionará. Se o framework de sua preferência (Solid, Preact, Lit, Qwik, SvelteKit, Angular, …) não tiver um template, você poderá criar a estrutura inicial por conta própria em poucos minutos.",
      "status": "final",
      "sourcePreview": "That doesn't mean those are your only options. The frontend of a Wails app is *just a\\ web project* …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
    },
    "b0017-heading-01": {
