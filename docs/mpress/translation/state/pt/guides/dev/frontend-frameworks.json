      "machineHash": "ceaf41ab8ee3dcf75e09dea649dc7f4395803fa9edea8133955434c49aadf8ab",
      "machineText": "*Os bindings são gerados em `frontend/bindings/`.* O Wails inspeciona os serviços Go registrados e grava nesse local um SDK com tipagem segura. Você pode importá-lo como qualquer outro módulo:",
      "status": "final",
      "sourcePreview": "*Bindings are generated into `frontend/bindings/`.* Wails inspects your registered Go services and w…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:42Z"
