      "machineHash": "6c91e1630446142f60123a427f4c0e815ceecebee782f5a8b707700385f965a5",
      "machineText": "Como o diretório `frontend/` é usado",
      "status": "final",
      "sourcePreview": "How the `frontend/` directory is used",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
