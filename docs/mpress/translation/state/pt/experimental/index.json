    "b0003-text-01": {
      "sourceHash": "3c91298071708809485a263f45cda29c9475c8a61c4d9d32ff191ffe6985eb93",
      "targetHash": "cae30c0a3e34cdfc67ead5e5a2d9d02b90399051998ce24756802d2cd40b2e54",
      "machineHash": "cae30c0a3e34cdfc67ead5e5a2d9d02b90399051998ce24756802d2cd40b2e54",
      "machineText": "O Wails disponibiliza experimentos abertamente. Um experimento é uma ideia que consideramos\\\npromissora o bastante para colocar em suas mãos desde cedo — mas com a qual ainda não\\\nassumimos um compromisso definitivo. Estamos publicando-a _porque_ queremos aprender com o uso real\\\nantes de decidir se ela se tornará uma parte permanente e com suporte do Wails.",
      "status": "final",
      "sourcePreview": "Wails ships experiments in the open. An experiment is an idea we think is\\ promising enough to put i…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
