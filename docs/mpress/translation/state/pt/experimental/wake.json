    "b0029-text-01": {
      "sourceHash": "cf845163f68c4801cb6daeea427d279b43ae53a452f659052e65868e1971d643",
      "targetHash": "a992efc1c1ec5329f5d78caeb574d3aca69dc8bcd7276f1f7cb8b9d4fd758195",
      "machineHash": "a992efc1c1ec5329f5d78caeb574d3aca69dc8bcd7276f1f7cb8b9d4fd758195",
      "machineText": "Uma tarefa com o *mesmo nome* substitui a tarefa base. Quando fornecidos pela substituição, os campos de lista (`cmds`, `deps`, `sources`, `generates`, `platforms`, `status`, `preconditions`, `aliases`) *substituem* os campos da base; os campos omitidos pela substituição são mantidos da base.",
      "status": "final",
      "sourcePreview": "A task with the *same name* overrides the base task. List fields (`cmds`, `deps`, `sources`, `genera…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:41Z"
    },
    "b0030-text-01": {
      "sourceHash": "2e6c81f509162acc33e81a9c9db6ac2e6fca3400db59c5081d7be4fc792bfde0",
      "targetHash": "e241cfde19a8efc00a75df8666cb699aa0fe228b99d143a8b2cbe3b3ea840203",
      "machineHash": "e241cfde19a8efc00a75df8666cb699aa0fe228b99d143a8b2cbe3b3ea840203",
      "machineText": "`env` e `vars` são *mesclados por chave*, e a substituição prevalece em caso de conflito.",
      "status": "final",
      "sourcePreview": "`env` and `vars` *merge per key*, with the override winning on collisions.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
