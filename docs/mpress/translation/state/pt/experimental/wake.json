      "machineHash": "d5364e5649b3462eb054a64857d6c29eb26edffd7796c313f2f7a56a39d34dc7",
      "machineText": "Uma tarefa que existe *somente* em um arquivo de substituição é *adicionada*.",
      "status": "final",
      "sourcePreview": "A task that exists *only* in an override file is *added*.",
      "provider": "codex",
