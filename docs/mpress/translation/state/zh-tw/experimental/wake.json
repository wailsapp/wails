    "b0002-text-01": {
      "sourceHash": "92aa16c3d3e739f8d2c98a059ebbcf64b1bb33f1c1fc825b1681b41a85b18915",
      "targetHash": "c52720f47b95d13850817842c203c614458b5dd00c792c0a6059376a41434c3e",
      "machineHash": "c52720f47b95d13850817842c203c614458b5dd00c792c0a6059376a41434c3e",
      "machineText": "Wake 是 `wails3` 的*實驗性替代建置執行器*。它會讀取專案已有的相同 `Taskfile.yml`，支援相同的 task、dep、var、template、include 與平台命名空間語法，並透過可感知 Wails 的執行器來執行，而不是使用通用的 [Task](https://taskfile.dev) 執行階段。",
      "status": "final",
      "sourcePreview": "Wake is an *experimental alternative build runner* for `wails3`. It reads the\\ same `Taskfile.yml` y…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:53Z"
    },
    "b0003-text-01": {
      "sourceHash": "5fb619f4a77d8c7d16538de1d913cc6411995c0b19aa57eaa6447fd73c58e1ce",
      "targetHash": "f0389ad8bab85864c7d08e3b3a748a37d0bf094ce029e61431eb2e9b9b34d47e",
      "machineHash": "f0389ad8bab85864c7d08e3b3a748a37d0bf094ce029e61431eb2e9b9b34d47e",
      "machineText": "其目標並非取代 Task，而是提供一個專為 Wails 專案實際建置方式打造的執行器，其語意、輸出與預設值皆與 `wails3` CLI 的其餘部分一致。*如果您始終只使用 Wake，便不必變更 Taskfile。*",
      "status": "final",
      "sourcePreview": "The goal isn't to replace Task. It's to provide a runner that's purpose-built\\ for the way Wails pro…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:53Z"
    },
    "b0004-heading-01": {
      "sourceHash": "77890c5d4168a3af5e9a2611921690bb9f2f6c2a02e7269ab9b268f2f1bbed00",
      "targetHash": "2f9cbe1ceef3af7eaf3b193b606cc6d8c53e4f51cd9d6da6f7b0a4f1629e400e",
      "machineHash": "2f9cbe1ceef3af7eaf3b193b606cc6d8c53e4f51cd9d6da6f7b0a4f1629e400e",
      "machineText": "存在理由",
      "status": "final",
