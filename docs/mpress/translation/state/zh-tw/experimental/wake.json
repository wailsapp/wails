    "b0001-text-01": {
      "sourceHash": "f6639045a768900e65d236888c7fe0824e17578daaf1bf9d4122913663d4f15f",
      "targetHash": "06cba7cb7c76d0ea107403cd5f434cd62965c9f791a705b91761696c201831c6",
      "machineHash": "06cba7cb7c76d0ea107403cd5f434cd62965c9f791a705b91761696c201831c6",
      "machineText": "Wake 必須透過 `WAILS_USE_WAKE=true` 主動啟用，*並非*預設執行器。\\\n未設定此變數時，`wails3 build / package / sign / task` 的行為與以往完全相同。\\\n各版本之間的功能涵蓋範圍與行為可能有所變更。",
      "status": "final",
      "sourcePreview": "Wake is opt-in behind `WAILS_USE_WAKE=true` and is *not* the default runner.\\ With the variable unse…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
