    "b0054-text-01": {
      "sourceHash": "ddbe45ef30c85b0c596becf60ba212bd372a1fbd6bfee69b0fecfad4f7af9066",
      "targetHash": "b88e1bef05b8b006d583723abf592faf58b0162c398ec42d37099cae800af218",
      "machineHash": "b88e1bef05b8b006d583723abf592faf58b0162c398ec42d37099cae800af218",
      "machineText": "桌面程式碼可在`GOOS=android`下直接編譯，不需修改；由於 Android 應用程式會以全螢幕顯示，幾何配置、選單和系統匣呼叫將不執行任何操作。",
      "status": "final",
      "sourcePreview": "Desktop code compiles unchanged under `GOOS=android`; geometry/menu/tray calls become no-ops because…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:54Z"
    },
    "b0055-text-01": {
      "sourceHash": "d207e8644dc3c8dbe954c0e210b9d87fad076b765b122a30ad597c956f4cada3",
      "targetHash": "cb7db3d0ac0be0141a65a8f2d643f0a600c1cbd2eda89b786fe73624fe2f635c",
      "machineHash": "cb7db3d0ac0be0141a65a8f2d643f0a600c1cbd2eda89b786fe73624fe2f635c",
      "machineText": "`android` *隱含`linux`建置標記*（Android 使用 Linux 核心）：僅適用於桌面 Linux 的檔案需要`//go:build linux \u0026\u0026 !android`，而在執行階段，`runtime.GOOS`為`\"android\"`。",
