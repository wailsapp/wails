    "b0001-text-01": {
      "sourceHash": "cca166bb456e03ca3f435d24321e9a38f2d9614960f564ac1a5cdcd61fdf5669",
      "targetHash": "055241bb1d7518d0d84f702d58278102a592351ae27eebfaeb749db8805d7e83",
      "machineHash": "055241bb1d7518d0d84f702d58278102a592351ae27eebfaeb749db8805d7e83",
      "machineText": "`NewNotchWindow` 會建立一個附著於相機模組外殼、具有特定形狀且不會啟用應用程式的 macOS 面板。Wails 負責原生定位、黑色連接翼、透明外層畫布、視窗層級、Spaces 行為，以及可選的顯示與隱藏動畫。網頁內容只會占用所要求的內部矩形區域。將指標移入視窗後，其 WebView 會立即成為鍵盤輸入目標，但不會啟用應用程式。",
      "status": "final",
      "sourcePreview": "`NewNotchWindow` creates a shaped, non-activating macOS panel attached to the\\ camera housing. Wails…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:53Z"
    },
    "b0002-text-01": {
