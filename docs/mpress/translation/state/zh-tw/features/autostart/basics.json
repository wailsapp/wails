      "machineHash": "5eba8a184222e558f92e77b3554095bbe688b4c39d0e07753e07f2a9637d97a7",
      "machineText": "註冊會在*下次登入*時生效，而非立即生效。",
      "status": "final",
      "sourcePreview": "Registration takes effect on the *next login*, not immediately.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
