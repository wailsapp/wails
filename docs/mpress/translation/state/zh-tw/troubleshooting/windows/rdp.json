    "b0003-text-01": {
      "sourceHash": "08a026f364fe72f8b99b6db4de2a46e4ee11d4df5b17bf78ff225aeee1ce0599",
      "targetHash": "9d0756614efa2e7b395eace10d3817b6ba54ab35e0694a9d8e60e4eae996742d",
      "machineHash": "9d0756614efa2e7b395eace10d3817b6ba54ab35e0694a9d8e60e4eae996742d",
      "machineText": "從按一下到快顯視窗顯示內容，大約需要 4 到 8 秒。",
      "status": "final",
      "sourcePreview": "Opening a popup window takes around 4 to 8 seconds from click to visible content.",
