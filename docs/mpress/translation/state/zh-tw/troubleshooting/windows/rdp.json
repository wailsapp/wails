    "b0005-text-01": {
      "sourceHash": "d528a1d5773854641980b0aef423c93931f6338184cfc55d29b58214736e577b",
      "targetHash": "53db82845098e150e710ae723a06b5f82b2f782ca8122121a6a33ccb8380775f",
      "machineHash": "53db82845098e150e710ae723a06b5f82b2f782ca8122121a6a33ccb8380775f",
      "machineText": "重新連線後，緩慢狀態仍會持續，且只有重新啟動主機後才會消除。",
      "status": "final",
      "sourcePreview": "The slow state persists across reconnects and only clears after the host machine is rebooted.",
