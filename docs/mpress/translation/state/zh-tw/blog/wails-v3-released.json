    "b0005-text-01": {
      "sourceHash": "37e45f8bb6db3867ca7f8edb0a2d5999818e43386d382bab6848fe488361d9db",
      "targetHash": "7e821981d2d5340ae99b3a44d30818fc53b2cac909bb922baef57e9ad418853c",
      "machineHash": "7e821981d2d5340ae99b3a44d30818fc53b2cac909bb922baef57e9ad418853c",
      "machineText": "如果你剛接觸 Wails：Wails 讓 Go 程式設計師能使用熟悉的 Web 前端工具建置桌面應用程式，並採用各平台的原生 WebView，而非內嵌瀏覽器。你可以用 Go 撰寫後端，用 HTML、CSS 與 JavaScript（或任何你偏好的框架）製作使用者介面，再由 Wails 將這些內容封裝成單一原生應用程式。",
      "status": "machine-translated",
      "sourcePreview": "If you're new here: Wails lets Go programmers build desktop applications with the web frontend tools…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:46:07Z"
    },
    "b0006-heading-01": {
      "sourceHash": "e52cd01f2c2e579783b55ed8379b76ee9bdfd015b9d9826df689b513c854b882",
