    "b0052-text-01": {
      "sourceHash": "df109e0d43319973464950e203bbe53f59a734444914296ddc8550df1fc4bb47",
      "targetHash": "71bb0884438f9967f3fc7fa00af16e60f6ef68238cfa67a2c4241203f45a7f7d",
      "machineHash": "71bb0884438f9967f3fc7fa00af16e60f6ef68238cfa67a2c4241203f45a7f7d",
      "machineText": "特別感謝[Fabio Massaioli（fbbdev）](https://github.com/fbbdev)打造出如此出色的靜態原始碼分析器與繫結產生器。它是 v3 得以運作的重要核心：一般的 Go 服務會轉換成 JavaScript 與 TypeScript API，型別和文件也會一併帶入前端。",
      "status": "machine-translated",
      "sourcePreview": "Special thanks to [Fabio Massaioli (fbbdev)](https://github.com/fbbdev) for creating such an amazing…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
