    "b0007-text-01": {
      "sourceHash": "634b46c2b8b775b659ef1f5d94b105655642736d7605643d5bf16083ad9f70bd",
      "targetHash": "771032e2d7581d7a6a60ce86cc66e14f014a7d1871ef0f014f8018397ebe9bcc",
      "machineHash": "771032e2d7581d7a6a60ce86cc66e14f014a7d1871ef0f014f8018397ebe9bcc",
      "machineText": "Wails v2 讓使用現代 Web 前端建置 Go 應用程式變得簡單直接，也一直為許多應用程式提供良好支援。但它採用單一視窗、由 context 驅動的執行階段，使某些常見的桌面應用開發工作變得比應有的更困難。",
      "status": "machine-translated",
      "sourcePreview": "Wails v2 made it straightforward to build a Go application with a modern web frontend, and it has se…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:46:07Z"
    },
    "b0008-text-01": {
      "sourceHash": "ed763b4b6065a5e608f90ceb1627996898970e38c8edf9110253fbe69d7a34c9",
      "targetHash": "4ba7abe63edb105d48ad93eb597da5d22a78369021cc8799a711a6834d03cea0",
      "machineHash": "4ba7abe63edb105d48ad93eb597da5d22a78369021cc8799a711a6834d03cea0",
      "machineText": "v3 採用不同的模型。應用程式、視窗、服務、事件與平台功能都是明確的物件。你會建立應用程式、註冊服務、建立視窗，並與擁有所需行為的物件互動。隨著應用程式成長，這種模型更容易理解；多視窗等功能也是模型中的常規部分，而非權宜之計。",
      "status": "machine-translated",
      "sourcePreview": "v3 starts from a different model. Applications, windows, services, events and platform capabilities …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:46:07Z"
    },
