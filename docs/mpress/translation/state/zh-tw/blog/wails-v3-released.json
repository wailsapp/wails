      "targetHash": "4c2070008a2a87953ba60badfdb7c1ee9eb11a7152756d4cba1f2c6524eceb29",
      "machineHash": "4c2070008a2a87953ba60badfdb7c1ee9eb11a7152756d4cba1f2c6524eceb29",
