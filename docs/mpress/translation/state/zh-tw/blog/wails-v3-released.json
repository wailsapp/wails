      "machineHash": "23d0d5437f46a1283979d0f227c181b3ff2279422a091a03cef1651445417b9c",
      "machineText": "Wails*究竟是*什麼？",
      "status": "machine-translated",
      "sourcePreview": "What *is* Wails?",
