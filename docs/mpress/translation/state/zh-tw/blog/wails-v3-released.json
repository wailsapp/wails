      "machineHash": "b61a97cda54647ffdcf921404d0246528a975caa76ba4832e8b607ea4a79dd3e",
      "machineText": "為什麼要推出 v3？",
      "status": "machine-translated",
      "sourcePreview": "Why v3?",
