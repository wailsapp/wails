    "b0042-text-01": {
      "sourceHash": "f152d075f74c0bb12a0b386727f5befce504801975d2d4abfe3bed495f4f3b84",
      "targetHash": "0498ce87290d13a8e36f1f312b7b79eff58a29b8f352b84408450b72a59464e1",
      "machineHash": "0498ce87290d13a8e36f1f312b7b79eff58a29b8f352b84408450b72a59464e1",
      "machineText": "Wails 的成長遠遠超出我的預期，而議題與提取要求的數量也一直令人難以負荷。過去發布版本有時缺乏固定規劃，修正與貢獻也等了太久才送到使用者手中。我們已建立系統，將分流處理與發布準備的更多基礎工作自動化，以便更快回應問題，並投入更多時間推出改進與新功能。",
      "status": "machine-translated",
      "sourcePreview": "Wails has grown far beyond what I expected, and it has been hard to keep up with the volume of issue…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:46:07Z"
    },
