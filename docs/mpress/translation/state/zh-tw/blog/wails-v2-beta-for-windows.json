    "b0032-text-01": {
      "sourceHash": "f197c0f9e5f5cf10e17ca7feff17b0cd8f0e4c598847e9fc5e008e7e913bd1c2",
      "targetHash": "b4ccdc6bf89686e9041d396725331cafd3ff867a65eab9afd6ae743f1fe10a4b",
      "machineHash": "b4ccdc6bf89686e9041d396725331cafd3ff867a65eab9afd6ae743f1fe10a4b",
      "machineText": "除此之外，系統還會在連接埠34115上啟動網頁伺服器，向任何連線至該連接埠的瀏覽器提供你的應用程式。所有已連線的網頁瀏覽器都會回應系統事件，例如資產變更時的熱重新載入。",
      "status": "final",
      "sourcePreview": "In addition to this, a webserver will start on port 34115. This will serve your\\ application to any …",
