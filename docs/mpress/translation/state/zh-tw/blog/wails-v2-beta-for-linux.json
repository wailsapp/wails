    "b0005-text-01": {
      "sourceHash": "ccba28ca464ea452ce656e7d55d7353d57d8ce82ba5046eb678f01e99151fbb0",
      "targetHash": "11c3cbd407a9ca392a74d01ff91427784d2706f8d88957380240bc22dbc0a403",
      "machineHash": "11c3cbd407a9ca392a74d01ff91427784d2706f8d88957380240bc22dbc0a403",
      "machineText": "許多人都要求支援原生選單，Wails 終於滿足了這項需求。現在已可使用應用程式選單，並支援大多數原生選單功能，包括標準選單項目、核取方塊、選項群組、子選單和分隔線。",
      "status": "final",
      "sourcePreview": "There were a lot of requests for native menu support. Wails has finally got you\\ covered. Applicatio…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
