    },
    "b0012-text-01": {
      "sourceHash": "48d705d794419374c335c65cac7cef32f970e4174656dff05fe94f8c693f30ab",
      "targetHash": "15ceef135e915aa2e572363ec9d5c8fd6d839729ff90aa28f3613afe21e1aa6d",
      "machineHash": "15ceef135e915aa2e572363ec9d5c8fd6d839729ff90aa28f3613afe21e1aa6d",
      "machineText": "只要將一個包含所有資源的`embed.FS`傳入應用程式設定即可。這些資源甚至不必位於頂層目錄，Wails 會自行處理。",
      "status": "final",
      "sourcePreview": "You just pass a single `embed.FS` that contains all your assets into your\\ application configuration…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
