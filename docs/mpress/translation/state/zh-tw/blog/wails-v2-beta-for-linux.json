    "b0011-text-01": {
      "sourceHash": "ae6fcca1a03cf57b9f3f22be3089cfcae3b710a6c3a97fdb37ba68ddbee56e88",
      "targetHash": "8372da3c4b1b04d73a0ff10c9ab9aa33578fa6cc373f6a51b667fbae3b633ee0",
      "machineHash": "8372da3c4b1b04d73a0ff10c9ab9aa33578fa6cc373f6a51b667fbae3b633ee0",
      "machineText": "那麼，我該如何納入資源？",
      "status": "final",
      "sourcePreview": "So how do I include my assets?",
