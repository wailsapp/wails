    "b0017-text-01": {
      "sourceHash": "2bca882edc0bd69289c5a727240e83166f45d4f44b281a9152db65681a572d0b",
      "targetHash": "d7049056d188aeab1ee58714f5c147cf793c867219a74fb82bf34c5af4816ca6",
      "machineHash": "d7049056d188aeab1ee58714f5c147cf793c867219a74fb82bf34c5af4816ca6",
      "machineText": "自動重建——Go 程式碼有任何變更時，都會重新建置並啟動應用程式",
      "status": "final",
      "sourcePreview": "Auto rebuild - Any changes to your Go code will rebuild and relaunch your application",
