    "b0008-text-01": {
      "sourceHash": "75850d60f7c5d266b05c5a27c7770661e5eacb4b662a43545782f84fbead8199",
      "targetHash": "44d785777e66428bcd3423561dbfd76e986fa2bafac7cbc4276498c7f363e62f",
      "machineHash": "44d785777e66428bcd3423561dbfd76e986fa2bafac7cbc4276498c7f363e62f",
      "machineText": "v1 的一大痛點，是必須將整個應用程式壓縮成單一 JS 與 CSS 檔案。我很高興地宣布，在 v2 中完全不必以任何形式綑綁資源。想載入本機圖片嗎？使用具有本機 src 路徑的`\u003c../../../assets/blog-images\u003e`標籤。想使用很酷的字型嗎？把它複製進來，然後在 CSS 中加入其路徑即可。",
      "status": "final",
      "sourcePreview": "A huge pain-point of v1 was the need to condense your entire application down to\\ single JS \u0026 CSS fi…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:51Z"
    },
    "b0009-text-01": {
