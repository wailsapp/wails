    "b0017-text-01": {
      "sourceHash": "84781f3e916189ecea0cb6dc18a593af67c9f3e1cb0bd50d19c3362e29092f17",
      "targetHash": "9b5b8990b2d03bbb2c61c3b205574385572d6820523cbf5bf32f9521a8fc2a47",
      "machineHash": "9b5b8990b2d03bbb2c61c3b205574385572d6820523cbf5bf32f9521a8fc2a47",
      "machineText": "В AppImage включены WebKit и его вспомогательные процессы, а встроенная библиотека исправлена так, чтобы запускать их из AppImage. Сценарий `AppRun` запускает приложение из `usr/lib` внутри AppImage. Исправленный путь разрешается как за пределами песочницы bubblewrap WebKit, так и внутри неё, поэтому песочница остаётся включённой. Используйте собственный `AppRun`, только если он сохраняет этот рабочий каталог.",
      "status": "machine-translated",
      "sourcePreview": "The AppImage bundles WebKit and its helper processes, and patches the bundled library to start them …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:41:18Z"
    },
