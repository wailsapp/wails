    "b0008-text-01": {
      "sourceHash": "210eae4115f30aae47fb114ad62863c417d3fa1d2c6b4bca77f6a8c7276a773b",
      "targetHash": "e942ba94f25561229f23508ac34ecf569d35fec7089e9cf037f36d3012a804d4",
      "machineHash": "e942ba94f25561229f23508ac34ecf569d35fec7089e9cf037f36d3012a804d4",
      "machineText": "Garble переименовывает экспортируемые поля структур, а Wails передаёт эти структуры в `json.Marshal` через параметр `interface{}`, который Garble не может отследить с помощью статического анализа. Сборка с обфускацией без тегов JSON успешно скомпилируется, но во время выполнения фронтенд получит искажённые или пустые имена полей. Добавьте теги перед запуском сборки с обфускацией.",
      "status": "final",
      "sourcePreview": "Garble renames exported struct fields, and Wails passes these structs to `json.Marshal` through an `…",
      "provider": "codex",
      "model": "gpt-6-astra",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:46Z"
    },
    "b0009-text-01": {
