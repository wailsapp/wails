    "b0007-text-01": {
      "sourceHash": "a15bda0be0b32b7fde862792b161ee9db7971016c8c19a0196cde012f79b02c6",
      "targetHash": "ecda4a6f1c4d5533348a139863586afd705c58c0a5f1a841f9e1d1b1553131b9",
      "machineHash": "ecda4a6f1c4d5533348a139863586afd705c58c0a5f1a841f9e1d1b1553131b9",
      "machineText": "У каждой структуры, которую возвращает или принимает метод привязанного сервиса, должны быть явно заданы теги JSON для всех экспортируемых полей:",
      "status": "final",
      "sourcePreview": "Any struct that a bound service method returns or accepts must have explicit JSON tags on every expo…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
