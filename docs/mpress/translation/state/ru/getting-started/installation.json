      "machineText": "Убедитесь, что Go установлен правильно: `go version`",
      "status": "final",
      "sourcePreview": "Check Go is installed correctly: `go version`",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:46Z"
