    "b0040-text-01": {
      "sourceHash": "1e8c8e71213aee2ebcd545508f43609fe240d5344cd59cc48baa34fc1dd6bf23",
      "targetHash": "dfbedb9e2df5cc41b211fc68754ef2720229b1832b7d4d7cf073c39f87ac738b",
      "machineHash": "dfbedb9e2df5cc41b211fc68754ef2720229b1832b7d4d7cf073c39f87ac738b",
      "machineText": "При наведении указателя окно у выреза выводится на передний план, а его webview получает фокус для немедленного взаимодействия с клавиатурой, при этом панель по-прежнему не активирует приложение.",
      "status": "final",
      "sourcePreview": "Pointer entry brings that notch window to the front and focuses its webview for immediate keyboard i…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0041-text-01": {
      "sourceHash": "601bf973640b72526ddf04767256e12b42f15dbb31a395c8957bd91a7ea8f52b",
      "targetHash": "41f71cb371af46f2cde7a95982746007391bd694adb77418598fc48b18b2f394",
      "machineHash": "41f71cb371af46f2cde7a95982746007391bd694adb77418598fc48b18b2f394",
      "machineText": "Каждый вызов `NewNotchWindow` создаёт независимое окно с собственным содержимым,\\\nсостоянием видимости и анимации. Окна используют один и тот же нативный уровень, поэтому\\\nпоследний показанный экземпляр или экземпляр, на который последним навели указатель, выводится на передний план и может перекрывать\\\nпредыдущие экземпляры. Если окна предназначены для разных экранов, каждое из них центрируется относительно\\\nкорпуса камеры соответствующего экрана. macOS не координирует окна у выреза, принадлежащие\\\nразным приложениям; если разные приложения показывают окна в одном месте и на\\\nодном уровне, последним выведенное окно оказывается на переднем плане.",
      "status": "final",
      "sourcePreview": "Each `NewNotchWindow` call creates an independent window with its own content,\\ visibility, and anim…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0042-text-01": {
      "sourceHash": "89ff278be803592f112ded0d2502f2c3a3ef275e0f5fd909874fe2ba8c8797b7",
      "targetHash": "a731d4fe86ea75269ba204ae1d3a68e4c13205deb2e826d0b673d7dca48af49a",
      "machineHash": "a731d4fe86ea75269ba204ae1d3a68e4c13205deb2e826d0b673d7dca48af49a",
      "machineText": "При работе с уведомлениями приложения обычно повторно используют скрытое окно или\\\nподдерживают собственную очередь в одном webview. Wails не навязывает очередь,\\\nзамену, автоматическое скрытие или политику единственного окна.",
      "status": "final",
      "sourcePreview": "For notification workloads, applications commonly reuse a hidden window or\\ maintain their own queue…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
