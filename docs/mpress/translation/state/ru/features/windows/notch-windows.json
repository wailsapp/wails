    "b0036-text-01": {
      "sourceHash": "117a5833ed4f4fa2ae057404e6e3ebcbf53c2519c196782242f2feafdd5923c3",
      "targetHash": "d8263e59a3c09ff75934fb919f7d2ded4dec0b045a71dc24cf0a067ce6349ade",
      "machineHash": "d8263e59a3c09ff75934fb919f7d2ded4dec0b045a71dc24cf0a067ce6349ade",
      "machineText": "`Show` показывает существующее нативное окно. Если анимация включена, оно выдвигается вниз из-за верхней границы дисплея.",
      "status": "final",
      "sourcePreview": "`Show` reveals the existing native window. With animation enabled, it slides down from above the dis…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
