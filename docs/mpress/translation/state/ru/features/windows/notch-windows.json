      "targetHash": "9cd26434a044352ff76df3cdb451ae3d0400343740ca24542118ef5540dbba26",
      "machineHash": "9cd26434a044352ff76df3cdb451ae3d0400343740ca24542118ef5540dbba26",
      "machineText": "Постоянные свёрнутые поверхности, которые вновь открываются при наведении, намеренно отделены\\\nот скрытия уведомлений и отслеживаются в\\\n[#6009](https://github.com/wailsapp/wails/issues/6009).",
      "status": "final",
      "sourcePreview": "Persistent collapsed surfaces that reopen on hover are intentionally separate\\ from notification hid…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0044-text-01": {
