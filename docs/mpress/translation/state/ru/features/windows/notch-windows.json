      "machineHash": "e077442f28cb46d063784ac384f4dae9b76ac72292a14b4207672ba5e6173a3f",
      "machineText": "Для прозрачности webview используется закрытый API",
      "status": "final",
      "sourcePreview": "Webview transparency uses a private API",
      "provider": "codex",
      "model": "gpt-5.6-sol",
