    "b0037-text-01": {
      "sourceHash": "ad98b2264d00caa78b81472f29f638c65e90b6cf6f4ca17847b7f900dddab4e1",
      "targetHash": "db4d9450b6bcbc944a45da339a699bc307a69366eb3d01096d4f2c7c196c86c2",
      "machineHash": "db4d9450b6bcbc944a45da339a699bc307a69366eb3d01096d4f2c7c196c86c2",
      "machineText": "`Hide` сохраняет окно для повторного использования. Если анимация включена, оно сдвигается обратно за верхнюю границу дисплея, прежде чем будет убрано с экрана. Webview, состояние JavaScript, привязки и обработчики событий остаются загруженными, но скрытое окно не реагирует на наведение; чтобы снова показать его, приложение должно вызвать `Show`.",
      "status": "final",
      "sourcePreview": "`Hide` keeps the window alive for reuse. With animation enabled, it slides back above the display be…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0038-text-01": {
      "sourceHash": "332d1b8ccff9ee9125563dcd4399dacd92f2fe7e0dfc7f2172270d4398a6a575",
      "targetHash": "f3369fe06fbdb967850869592aaf3cf7f0f491a60b45898bcb7758c9858029d2",
      "machineHash": "f3369fe06fbdb967850869592aaf3cf7f0f491a60b45898bcb7758c9858029d2",
      "machineText": "`Visibility` сообщает текущее состояние нативной видимости.",
      "status": "final",
      "sourcePreview": "`Visibility` reports the current native visibility.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
