    "b0039-text-01": {
      "sourceHash": "3270dcda0866ee743c136655da04a9d3dd9dbdca98c6431bcb935560494f1e16",
      "targetHash": "0e0fc71e45914e23f09037e55a041bd1b22e689d15df1f059719062c4ddc3b39",
      "machineHash": "0e0fc71e45914e23f09037e55a041bd1b22e689d15df1f059719062c4ddc3b39",
      "machineText": "`Close` безвозвратно уничтожает нативное окно. Прежде чем снова показать это уведомление, создайте новое окно.",
      "status": "final",
      "sourcePreview": "`Close` permanently destroys the native window. Create a new one before showing that notification ag…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
