      "machineHash": "5170a472c9f6ae6c02cdd22a518a2aa13950ae5800f8aa9ffc2597ed794fcbc4",
      "machineText": "`WindowClosing` отправляется при попытках закрытия, инициированных пользователем.",
      "status": "final",
      "sourcePreview": "`WindowClosing` is dispatched on user-initiated close attempts.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
