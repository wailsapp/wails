    "b0007-text-01": {
      "sourceHash": "8a786055a624b4d6bf55049220f2d1705abfa2184b9737ac5e7a9ef6bb66deec",
      "targetHash": "57048be8f9c02efe5c48f6ad1a7b35db0e1eac2ebf8d9ff49755f3a96e42da7e",
      "machineHash": "57048be8f9c02efe5c48f6ad1a7b35db0e1eac2ebf8d9ff49755f3a96e42da7e",
      "machineText": "Чтобы выполнять функцию обратного вызова при каждом создании окна, используйте `app.Window.OnCreate`:",
      "status": "final",
      "sourcePreview": "Run a callback every time a window is created using `app.Window.OnCreate`:",
