    "b0001-text-01": {
      "sourceHash": "3f5c094b5d023962c120607e9e613c7ca86d839eca734b9e55064832b2346da7",
      "targetHash": "2d94cd285b7cc607b0548506af2d54ba1cf36a4123e4d412059eaaa7c52c9d00",
      "machineHash": "2d94cd285b7cc607b0548506af2d54ba1cf36a4123e4d412059eaaa7c52c9d00",
      "machineText": "Механизм перетаскивания HTML5 позволяет пользователям перетаскивать элементы в интерфейсе приложения — например, менять порядок элементов списка или перемещать их между столбцами. Это стандартная веб-функция, которая работает в Wails без какой-либо дополнительной настройки.",
      "status": "final",
      "sourcePreview": "HTML5 drag-and-drop lets users drag elements within your app's UI - for example, reordering a list o…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
