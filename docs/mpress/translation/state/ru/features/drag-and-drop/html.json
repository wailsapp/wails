    },
    "b0003-text-01": {
      "sourceHash": "c64ca802d5c17b232f445a6dd87a86bda31900207a663884ad8c6b7426926c8a",
      "targetHash": "f55fecee803964a0d4ce60fc5c208ea7fb89f33b215baf1b3755c00dd04dad3b",
      "machineHash": "f55fecee803964a0d4ce60fc5c208ea7fb89f33b215baf1b3755c00dd04dad3b",
      "machineText": "По умолчанию большинство элементов нельзя перетаскивать. Чтобы сделать элемент перетаскиваемым, добавьте `draggable=\"true\"`:",
      "status": "final",
      "sourcePreview": "By default, most elements can't be dragged. To make an element draggable, add `draggable=\"true\"`:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0004-text-01": {
      "sourceHash": "010fea07f16972470cdf59e1a4b379ff263ab06d0e5a8f682020c504db5aff62",
      "targetHash": "2ddc67d42a17131e45988f3ea841ef8f1f48b903670b3a48c787d47230a323e6",
      "machineHash": "2ddc67d42a17131e45988f3ea841ef8f1f48b903670b3a48c787d47230a323e6",
      "machineText": "Теперь, когда пользователь нажмёт на элемент и начнёт его перетаскивать, будет отображаться предварительное изображение элемента.",
      "status": "final",
      "sourcePreview": "The element will now show a drag preview when the user clicks and drags it.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
