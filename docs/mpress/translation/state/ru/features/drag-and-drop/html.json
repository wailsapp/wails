      "machineHash": "9e62368a1b8af477bc3d44781c8792324aafd2c7de0a66ff379248cfac758657",
      "machineText": "Как сделать элемент перетаскиваемым",
      "status": "final",
      "sourcePreview": "Make an Element Draggable",
