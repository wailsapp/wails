      "machineHash": "122e0d3b0b990c85d6a6fa9fbab27ac47876e061c6a80a96867384ebe9780971",
      "machineText": "Класс удаляется автоматически, когда файлы покидают зону или сбрасываются в неё.",
      "status": "final",
      "sourcePreview": "The class is removed automatically when files leave the zone or are dropped.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
