    "b0008-text-01": {
      "sourceHash": "0fa06954c8975ddadc75dabe7e37b7bf7f26eed773673de43473cc2397a2f824",
      "targetHash": "ae935dafb9159c7c6d0247d64184343250d6334c4b6d7d9a66b2e9fd59270162",
      "machineHash": "ae935dafb9159c7c6d0247d64184343250d6334c4b6d7d9a66b2e9fd59270162",
      "machineText": "Зоны приёма указывают Wails, какие элементы должны принимать файлы. Файлы, сброшенные за пределами зоны приёма, игнорируются.",
      "status": "final",
      "sourcePreview": "Drop zones tell Wails which elements should accept files. Files dropped outside a drop zone are igno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0009-text-01": {
      "sourceHash": "7041708858af91bf382403db8bab2de5b86651bcf9847d79395e88511a708a70",
      "targetHash": "5effa5319b11b872e2fdee1b78162490b20b379d03dd818ac5f2aa80819be297",
      "machineHash": "5effa5319b11b872e2fdee1b78162490b20b379d03dd818ac5f2aa80819be297",
      "machineText": "Добавьте атрибут `data-file-drop-target` к любому элементу:",
      "status": "final",
      "sourcePreview": "Add the `data-file-drop-target` attribute to any element:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0010-text-01": {
