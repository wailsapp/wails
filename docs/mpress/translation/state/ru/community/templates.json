    "b0002-text-01": {
      "sourceHash": "b1fb87fcc92adf5999298085d37b181b1859b2693edd5b066cd43e82c3a868b4",
      "targetHash": "753f34adcdda67332407a318cfe4dfff220ceed1b59d3f197dbb04b1a7881ffd",
      "machineHash": "753f34adcdda67332407a318cfe4dfff220ceed1b59d3f197dbb04b1a7881ffd",
      "machineText": "На этой странице перечислены шаблоны, поддерживаемые сообществом. Чтобы создать собственный\\\nшаблон, обратитесь к руководству [«Шаблоны»](https://wails.io/docs/guides/templates).",
      "status": "final",
      "sourcePreview": "This page serves as a list for community supported templates. To build your own\\ template, please se…",
