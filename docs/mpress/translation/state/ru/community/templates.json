    "b0004-text-01": {
      "sourceHash": "ffe000c3d9285fda4825e6323583992cda78701a62aa6390021857b5c1bfaca9",
      "targetHash": "82feb8e815442a8ef9a901ffe002c79fea3d63e4cf58686ca182c534ff7dd418",
      "machineHash": "82feb8e815442a8ef9a901ffe002c79fea3d63e4cf58686ca182c534ff7dd418",
      "machineText": "Чтобы использовать эти шаблоны, выполните команду:\\\n`wails init -n \"Your Project Name\" -t [the link below[@version]]`",
      "status": "final",
      "sourcePreview": "To use these templates, run\\ `wails init -n \"Your Project Name\" -t [the link below[@version]]`",
      "provider": "codex",
      "model": "gpt-5.6-sol",
