    "b0001-text-01": {
      "sourceHash": "4aef95ace7f57b1a43ae406c80116085cb1856fff57bee4c238403ff90efd4a8",
      "targetHash": "f7595f8a289c021ef58c413ef50200332966efd043d9b09a1825f416c0dfb4de",
      "machineHash": "f7595f8a289c021ef58c413ef50200332966efd043d9b09a1825f416c0dfb4de",
      "machineText": "В Wails v3 используется **M-Press**, который преобразует Markdown в этот сайт документации. Вы можете исправить опечатку, улучшить объяснение, добавить пример или руководство либо исправить перевод. Для исправлений, затрагивающих только документацию, не требуется заранее создавать задачу или получать ошибку в тесте кода.",
      "status": "machine-translated",
      "sourcePreview": "Wails v3 uses **M-Press** to turn Markdown into this documentation site. You can fix a typo, improve…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:33:34Z"
    },
    "b0002-text-01": {
      "sourceHash": "3598ed993b49814ab7e5d0aa18579a81500a70138083eb02bd24fbf4c483fa56",
      "targetHash": "d24276833d3217543516b0476ee210272405adbd6a48dd24022e4c2f52cd4705",
      "machineHash": "d24276833d3217543516b0476ee210272405adbd6a48dd24022e4c2f52cd4705",
      "machineText": "Чтобы подготовить изменения, вам понадобится Git, а чтобы отправить pull request — учётная запись GitHub. Загружаемый исполняемый файл M-Press содержит генератор документации и средство отрисовки диаграмм; для предварительного просмотра документации не нужны Go, Node.js, Wails CLI или зависимости для сборки настольных приложений. Для дополнительных скриптов проверки репозитория требуется Python 3.",
      "status": "machine-translated",
      "sourcePreview": "You need Git to prepare a contribution and a GitHub account to submit a pull request. The downloadab…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:33:34Z"
    },
    "b0003-heading-01": {
      "sourceHash": "e9b6dbde3ac9c777b0c2d7c97c73707bece12eddcc22fcbb5165dbb768d8515f",
      "targetHash": "57e56a394569e4963b7ffc61f0f0705d3e5aa4e933d7ca1500dc4a5669a30738",
      "machineHash": "57e56a394569e4963b7ffc61f0f0705d3e5aa4e933d7ca1500dc4a5669a30738",
      "machineText": "Начните со страницы документации",
      "status": "machine-translated",
      "sourcePreview": "Start from a documentation page",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
