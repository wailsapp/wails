    "b0050-text-01": {
      "sourceHash": "3a4355213b855603b2927555f3b536e969c45bbfb958085d9b7c54fc0c98e13c",
      "targetHash": "f3ad902f6bbea94f1822ff917446a6574bd4b26bbd11ba451b952451e8acdef3",
      "machineHash": "f3ad902f6bbea94f1822ff917446a6574bd4b26bbd11ba451b952451e8acdef3",
      "machineText": "В Windows используйте `python`, если Python 3 установлен именно так. Если [Task](https://taskfile.dev/) уже установлен, `task docs:build` запускает те же проверки с `mpress` из PATH.",
      "status": "machine-translated",
      "sourcePreview": "Use `python` on Windows if that is how Python 3 is installed. If [Task](https://taskfile.dev/) is al…",
