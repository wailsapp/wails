    "b0028-text-01": {
      "sourceHash": "74a72a7383e46d3e6e99c9df34ae170d855015093eed8707b1bc771555d5f396",
      "targetHash": "2ccf06905c14670c91d32da798d9459d62ff7e528169284abeba7f11d2f36fe9",
      "machineHash": "2ccf06905c14670c91d32da798d9459d62ff7e528169284abeba7f11d2f36fe9",
      "machineText": "*Правила слияния (локальные значения имеют приоритет):*",
