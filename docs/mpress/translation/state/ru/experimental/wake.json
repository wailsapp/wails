    "b0032-text-01": {
      "sourceHash": "57760064c375f54c9b2af0c53ae7da5c4c42f308c4a1324bc56baee880481111",
      "targetHash": "d4007d790a991fe9bcd9be48d2f7e42c33fa0babd96841fff192615d5640cd1a",
      "machineHash": "d4007d790a991fe9bcd9be48d2f7e42c33fa0babd96841fff192615d5640cd1a",
      "machineText": "Например, если хранящийся в репозитории `Taskfile.yml` выполняет сборку с флагами разработки, но на вашем\\\nкомпьютере всегда должна выполняться производственная сборка:",
      "status": "final",
      "sourcePreview": "For example, if the committed `Taskfile.yml` builds with dev flags but your\\ machine should always b…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:45Z"
    },
    "b0033-text-01": {
