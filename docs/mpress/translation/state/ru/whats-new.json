    "b0001-text-01": {
      "sourceHash": "44479da91d327a99d03a59ecd05a869c26846bcf93c03e8dc6243a360961da4d",
      "targetHash": "548c97492a7276608ad7111cb4982c3f3ec26fb17baff92e710ff8b39b063c90",
      "machineHash": "548c97492a7276608ad7111cb4982c3f3ec26fb17baff92e710ff8b39b063c90",
      "machineText": "В Wails v3 внесены значительные изменения по сравнению с v2. Вместо декларативного API для работы с одним окном теперь используется более гибкий процедурный подход. Новый дизайн API повышает читаемость кода и упрощает разработку, особенно сложных многооконных приложений.",
      "status": "final",
      "sourcePreview": "Wails v3 introduces significant changes from v2. It replaces the\\ single-window, declarative API wit…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:47Z"
    },
    "b0002-text-01": {
      "sourceHash": "97c252aca10ec764355d68d945df86e9e1c3cfea84c0d5539e8e58e819f750d3",
      "targetHash": "8c7ac26c0f3f4baf53726cf7e4167fc3a803561a13ba760569a8ed34b9e8c964",
      "machineHash": "8c7ac26c0f3f4baf53726cf7e4167fc3a803561a13ba760569a8ed34b9e8c964",
      "machineText": "Wails v3 представляет собой существенный шаг вперёд в разработке настольных приложений с использованием Go и веб-технологий.",
      "status": "final",
      "sourcePreview": "Wails v3 represents a substantial evolution in how desktop applications\\ can be built using Go and w…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:47Z"
    },
