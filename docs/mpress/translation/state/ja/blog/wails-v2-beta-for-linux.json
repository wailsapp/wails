    "b0017-text-01": {
      "sourceHash": "2bca882edc0bd69289c5a727240e83166f45d4f44b281a9152db65681a572d0b",
      "targetHash": "942f95d5a4ecbf5041e996a52f78023c36da395f23173a523e2bb87cccc4590b",
      "machineHash": "942f95d5a4ecbf5041e996a52f78023c36da395f23173a523e2bb87cccc4590b",
      "machineText": "自動リビルド — Goコードを変更すると、アプリケーションが再ビルドされ、再起動します",
      "status": "final",
