      "targetHash": "5e9666243d8448acc401beea4a96d6ff57973e85dde5cb481a5b90a44dd6151c",
      "machineHash": "5e9666243d8448acc401beea4a96d6ff57973e85dde5cb481a5b90a44dd6151c",
      "machineText": "では、アセットはどうやって組み込むのでしょうか？",
      "status": "final",
