    },
    "b0018-text-01": {
      "sourceHash": "8a449bb8f7b7fc6f5a19868d04e4afe3eb4e94f058df87e3b82e43fab4ac8758",
      "targetHash": "4542acbd6e0c683595c0002d57a66f126a1514fdf0864fc84deaf7318dbb9667",
      "machineHash": "4542acbd6e0c683595c0002d57a66f126a1514fdf0864fc84deaf7318dbb9667",
      "machineText": "Wails は、`frontend/` 内でどのフレームワークが使われているかを問いません。依存するのは、フレームワークに依存しない次の簡単な規約だけです。",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:34Z"
    },
    "b0019-text-01": {
      "sourceHash": "e553627e73bba47136f29e006d9ddce93f0ff8d3c7d49a5b466b81eb4e03908f",
      "targetHash": "ffbd4b6d0a7d1996e0b69a28200c59402674f3fc88e3742d4fc9df4ddabe0f7d",
      "machineHash": "ffbd4b6d0a7d1996e0b69a28200c59402674f3fc88e3742d4fc9df4ddabe0f7d",
      "machineText": "*`frontend/dist/` が配布物になります。* `main.go` は、ビルド済みのフロントエンドを `//go:embed all:frontend/dist` で埋め込み、アセットサーバーから配信します。ビルドでは、静的バンドルを `frontend/dist/`（Vite のデフォルト出力ディレクトリ）に出力する必要があります。",
      "status": "final",
      "sourcePreview": "*`frontend/dist/` is what ships.* `main.go` embeds the built frontend with `//go:embed all:frontend/…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:34Z"
    },
    "b0020-text-01": {
      "sourceHash": "85e415e7c1f9045cbb3a31fee14621a3ec827c2e4478d35a23e435edbe2913f0",
      "targetHash": "82d364d505a30eb6f00e248e2c03bd79fc3933778689a1c5ab3373d72e6f2452",
      "machineHash": "82d364d505a30eb6f00e248e2c03bd79fc3933778689a1c5ab3373d72e6f2452",
      "machineText": "*ビルドは `frontend/package.json` によって実行されます。* `wails3 build` の実行中、Wails はフロントエンドの `build` スクリプトを実行します。`wails3 dev` の実行中は `dev` を実行し、ホットリロードのために Vite 開発サーバーをプロキシします。",
      "status": "final",
      "sourcePreview": "*The build is driven by `frontend/package.json`.* During `wails3 build`, Wails runs the frontend's `…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:34Z"
    },
    "b0021-text-01": {
