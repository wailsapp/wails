    "b0002-text-01": {
      "sourceHash": "67452cf276bdcad745b95180be79317d91eebcc42df1a86d8092bb651f31b4c7",
      "targetHash": "40475d617c56b62dbce52d7ea48f2188d2a2875f232be901c7026408e0813688",
      "machineHash": "40475d617c56b62dbce52d7ea48f2188d2a2875f232be901c7026408e0813688",
      "machineText": "Wails アプリケーションをリモート デスクトップ（RDP）セッション経由で使用すると、一般的な操作で UI が数秒間停止することがあります。",
      "status": "final",
      "sourcePreview": "When a Wails application is used over a Remote Desktop (RDP) session, the UI can stall for several s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0003-text-01": {
      "sourceHash": "08a026f364fe72f8b99b6db4de2a46e4ee11d4df5b17bf78ff225aeee1ce0599",
      "targetHash": "1a897f750be123ec176c4680db406246c2654f57755443772238ce5e69cc3eba",
      "machineHash": "1a897f750be123ec176c4680db406246c2654f57755443772238ce5e69cc3eba",
      "machineText": "ポップアップ ウィンドウを開くと、クリックしてから内容が表示されるまでに約 4～8 秒かかります。",
      "status": "final",
      "sourcePreview": "Opening a popup window takes around 4 to 8 seconds from click to visible content.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0004-text-01": {
      "sourceHash": "bdd91f74f88af18a0c1ea11944994df216f5140bdf137b2655aa355a4a1c4101",
      "targetHash": "aa3b2a00a8b9b1d5964debfb53dff1e8dd538b86ed94970c71d7ccaac3c0b14c",
      "machineHash": "aa3b2a00a8b9b1d5964debfb53dff1e8dd538b86ed94970c71d7ccaac3c0b14c",
      "machineText": "ウィンドウを閉じると、親ウィンドウが約 2 秒間ブロックされます。",
      "status": "final",
      "sourcePreview": "Closing a window blocks the parent window for around 2 seconds.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0005-text-01": {
      "sourceHash": "d528a1d5773854641980b0aef423c93931f6338184cfc55d29b58214736e577b",
      "targetHash": "83047cf101e452e80bed752c7fcc97d3e3d318473ae29403d1439967b0b87eab",
      "machineHash": "83047cf101e452e80bed752c7fcc97d3e3d318473ae29403d1439967b0b87eab",
      "machineText": "この低速な状態は再接続後も続き、ホスト マシンを再起動するまで解消されません。",
      "status": "final",
      "sourcePreview": "The slow state persists across reconnects and only clears after the host machine is rebooted.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0006-text-01": {
      "sourceHash": "06e4acf0308131114e108506277c8f7217395c3e17a3ec2dff01d92c7dc3baef",
      "targetHash": "93d7c4fec5073345a6537aa72cb2f6c1884b4cceba4702861018125ed8340894",
      "machineHash": "93d7c4fec5073345a6537aa72cb2f6c1884b4cceba4702861018125ed8340894",
      "machineText": "この問題は、セッションの途中で Retina 向けに最適化された仮想モニターを構成する Microsoft Remote Desktop の iOS クライアントで特によく発生します。セッションの途中で異なる DPI コンテキストのモニターを追加する RDP クライアントであれば、どれでも同じ動作を引き起こす可能性があります。",
      "status": "final",
      "sourcePreview": "This is most often seen with the Microsoft Remote Desktop client on iOS, which provisions a Retina-o…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0007-heading-01": {
      "sourceHash": "8d892c3c9826b727d4d2be362514e8b2a3cc70ef065ff4d6966df2bc12ca4cfe",
      "targetHash": "597967e5655b358f462b7682b70e8a62e23c198f4ca1027c8aa119bb74a98a12",
      "machineHash": "597967e5655b358f462b7682b70e8a62e23c198f4ca1027c8aa119bb74a98a12",
      "machineText": "発生する理由",
      "status": "final",
      "sourcePreview": "Why it happens",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0008-text-01": {
      "sourceHash": "67624803118f6b099746a66d2efc4a1f46e762fd3a0da054a03e27e1b3b5084f",
      "targetHash": "19cf1e10cbbb0643c4d90570fe8cac7e960dce3ccd827399730accce38c721f0",
      "machineHash": "19cf1e10cbbb0643c4d90570fe8cac7e960dce3ccd827399730accce38c721f0",
      "machineText": "WebView2 はデフォルトでウィンドウ ホスティングを使用し、コンポジター サーフェスは子ウィンドウ内に配置されます。RDP クライアントがセッションとは異なる DPI コンテキストのモニターを追加すると、WebView2 コントローラーの各呼び出し（`PutIsVisible`、`MoveFocus`、初回描画、サーフェスの解放）によって、同期的な DirectComposition の再マーシャリングが強制されます。再マーシャリングのたびに UI スレッドが約 2 秒間ブロックされるため、ポップアップを多用するアプリでは停止時間が積み重なります。",
      "status": "final",
      "sourcePreview": "By default, WebView2 uses windowed hosting, where its compositor surface lives in a child window. Wh…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0009-text-01": {
      "sourceHash": "37fe272ea2e1484e7161b493827e9fb21e6a97fcf3d25096cbe8623596f2f7de",
      "targetHash": "aa40afb1e0a17e5d13c8e62a7c10a3cc36cd5990b9e36a599282a3a297c84233",
      "machineHash": "aa40afb1e0a17e5d13c8e62a7c10a3cc36cd5990b9e36a599282a3a297c84233",
      "machineText": "同じマシン上のネイティブ Win32 と WebView2 を組み合わせたアプリケーションは、ビジュアル ホスティングを使用するため影響を受けません。このことから、原因は WebView2 や Windows コンポジター全般の問題ではなく、ホスティング モードにあると判断できます。",
      "status": "final",
      "sourcePreview": "A native Win32 plus WebView2 application on the same machine is unaffected, because it relies on vis…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0010-heading-01": {
      "sourceHash": "22927695994eab589c7601a6b15df4d9dc67c5aceb9a74cdb965444b9b8362a6",
      "targetHash": "e83a7a0fbefea056dc68336b62b9e4a76195bf1628d8e445372533fbce51859c",
      "machineHash": "e83a7a0fbefea056dc68336b62b9e4a76195bf1628d8e445372533fbce51859c",
      "machineText": "解決策",
      "status": "final",
      "sourcePreview": "Solution",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0011-text-01": {
      "sourceHash": "b1ce0771547b1109b1294959f92a86d5dbefb5394e3efcfb49abc303fc199dab",
      "targetHash": "6cdadd056fc91a825b05ad56ef1f43ecf7a68fa751972fddb3cd7624318486c1",
      "machineHash": "6cdadd056fc91a825b05ad56ef1f43ecf7a68fa751972fddb3cd7624318486c1",
      "machineText": "Windows オプションで `UseVisualHosting` を設定し、ビジュアル ホスティングを有効にします。ビジュアル ホスティングでは、WebView2 のコンポジター サーフェスはホストが所有する DirectComposition ビジュアルを介して管理されるため、DPI コンテキストが変化しても同期的な再マーシャリングは発生しなくなります。",
      "status": "final",
      "sourcePreview": "Enable visual hosting by setting `UseVisualHosting` in your Windows options. With visual hosting, We…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0012-text-01": {
      "sourceHash": "0bd1231730bc139dd76f2ed8b6dd9d56cc4d39706b0106e0f79482d2e038b109",
      "targetHash": "952c8b78e127df060a3a5801c02eb0a0807e5ac6bc775f835202219540ea2f1a",
      "machineHash": "952c8b78e127df060a3a5801c02eb0a0807e5ac6bc775f835202219540ea2f1a",
      "machineText": "有効にすると、ポップアップは通常のナビゲーション時間内（約 150～500 ミリ秒）に開き、ウィンドウを閉じても親ウィンドウがブロックされなくなります。",
      "status": "final",
      "sourcePreview": "After enabling it, popups open within normal navigation time (roughly 150 to 500 ms) and closing a w…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0013-text-01": {
      "sourceHash": "1095da597effe3f8682fc0cc28877f584d5f150ee2c7683b436966b82db82087",
      "targetHash": "c9de7838d5a8cf54ec0b4159bdf7b4d34bcfb3bc55c3b88681da7df74300a344",
      "machineHash": "c9de7838d5a8cf54ec0b4159bdf7b4d34bcfb3bc55c3b88681da7df74300a344",
      "machineText": "`UseVisualHosting` は `app.Run()` より前に設定する必要があります。Wails はアプリケーションの起動時にこの値を読み取り、WebView2 環境を初期化する前に環境変数 `COREWEBVIEW2_FORCED_HOSTING_MODE` を `COREWEBVIEW2_HOSTING_MODE_WINDOW_TO_VISUAL` に設定します。それより後に設定しても効果はありません。",
      "status": "final",
      "sourcePreview": "`UseVisualHosting` must be set before `app.Run()`. Wails reads it during application startup and set…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0014-text-01": {
      "sourceHash": "6175ac3099231cbf4b322158c3a55f5c5e89aee4c8c43a4737a904aabd7ea1d4",
      "targetHash": "dcc195af8667945be3124a25d7cc5c9198678c82dde7526d045d239356a74c12",
      "machineHash": "dcc195af8667945be3124a25d7cc5c9198678c82dde7526d045d239356a74c12",
      "machineText": "このオプションのデフォルト値は `false` であるため、ウィンドウ ホスティングが引き続きデフォルトです。既存のアプリでは、明示的に有効にしない限り動作は変わりません。",
      "status": "final",
      "sourcePreview": "The option defaults to `false`, so windowed hosting remains the default. Existing apps see no change…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0015-heading-01": {
      "sourceHash": "799b9a9514031be2ec15a8792bda8b4c29a1b5811a428160c53813046a5f0275",
      "targetHash": "735af6a14ef0fbadcc02969f75138f92777f7ea1e2fa2d037958afa1ba041696",
      "machineHash": "735af6a14ef0fbadcc02969f75138f92777f7ea1e2fa2d037958afa1ba041696",
      "machineText": "有効にする場合",
      "status": "final",
      "sourcePreview": "When to enable it",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
    "b0016-text-01": {
      "sourceHash": "0c3ce80389ffa7b2ee0008b1385065df4d3e50ab71cdf8f6cbadc98b739f63ef",
      "targetHash": "cc8f075e42ba022837b52edd5cf807a4a7f0a235fa26220e3847776692ec39f5",
      "machineHash": "cc8f075e42ba022837b52edd5cf807a4a7f0a235fa26220e3847776692ec39f5",
      "machineText": "アプリが RDP 経由、特に Microsoft Remote Desktop の iOS クライアント経由で頻繁に使用され、ウィンドウを開閉する際に数秒間の停止が発生する場合は、`UseVisualHosting: true` を設定してください。アプリを RDP 経由で実行しない場合、このオプションは不要であり、デフォルトのままにできます。",
      "status": "final",
      "sourcePreview": "Set `UseVisualHosting: true` if your app is regularly used over RDP, especially the Microsoft Remote…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:35Z"
    },
