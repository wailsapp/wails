    "b0038-text-01": {
      "sourceHash": "b3870b952e6078266994b9ea15d8b170b940d8ea15ab03e4d6fd7350507481bd",
      "targetHash": "05dd832416b837b550cbd50a5c18f42cc88d106e43ad3d3bf88588dcf50a9a1b",
