    "b0038-text-01": {
      "sourceHash": "b3870b952e6078266994b9ea15d8b170b940d8ea15ab03e4d6fd7350507481bd",
      "targetHash": "505043a124b878c86315641c830e4c99c00147725111fc088bf5576650bbfe61",
      "machineHash": "505043a124b878c86315641c830e4c99c00147725111fc088bf5576650bbfe61",
      "machineText": "別のアプリケーションがすでに同じ組み合わせを占有していると登録は失敗するため、デフォルトにはあまり一般的でない組み合わせを使用してください。",
      "status": "machine-translated",
      "sourcePreview": "Registration fails if another application already owns the combination, so prefer less common combin…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:09:26Z"
    },
