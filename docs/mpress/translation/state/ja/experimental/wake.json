      "machineHash": "01b82c1de9839af6dc58aa4f13cc047b7140b6d07ac2baa61a3a5e7173ebbd43",
      "machineText": "`env` と `vars` は*キーごとにマージ*され、キーが競合した場合はオーバーライド側が優先されます。",
      "status": "final",
      "sourcePreview": "`env` and `vars` *merge per key*, with the override winning on collisions.",
      "provider": "codex",
      "model": "gpt-5.6-sol",
