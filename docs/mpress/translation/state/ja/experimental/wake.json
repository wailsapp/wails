    "b0002-text-01": {
      "sourceHash": "92aa16c3d3e739f8d2c98a059ebbcf64b1bb33f1c1fc825b1681b41a85b18915",
      "targetHash": "649c793550da0f97f041a67fc63afc0f876a4ce9dc926b4679586f9c38cdca5d",
      "machineHash": "649c793550da0f97f041a67fc63afc0f876a4ce9dc926b4679586f9c38cdca5d",
      "machineText": "Wake は、`wails3` 向けの*実験的な代替ビルドランナー*です。プロジェクトにすでに存在するものと同じ `Taskfile.yml`、つまり同じ task、dep、var、template、include、およびプラットフォーム名前空間の構文を読み取り、汎用の [Task](https://taskfile.dev) ランタイムではなく、Wails 対応のエグゼキューターで実行します。",
      "status": "final",
      "sourcePreview": "Wake is an *experimental alternative build runner* for `wails3`. It reads the\\ same `Taskfile.yml` y…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:33Z"
    },
    "b0003-text-01": {
      "sourceHash": "5fb619f4a77d8c7d16538de1d913cc6411995c0b19aa57eaa6447fd73c58e1ce",
      "targetHash": "f1a6abdbbcebca9808cf46238d0ca5b9b43e9864b6570523b28c4caa583ea24d",
      "machineHash": "f1a6abdbbcebca9808cf46238d0ca5b9b43e9864b6570523b28c4caa583ea24d",
      "machineText": "目的は Task を置き換えることではありません。Wails プロジェクトの実際のビルド方法に特化し、`wails3` CLI の他の部分と一致するセマンティクス、出力、デフォルト設定を備えたランナーを提供することです。*Wake だけを使用する限り、Taskfile を変更する必要はありません。*",
      "status": "final",
      "sourcePreview": "The goal isn't to replace Task. It's to provide a runner that's purpose-built\\ for the way Wails pro…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:33Z"
    },
    "b0004-heading-01": {
      "sourceHash": "77890c5d4168a3af5e9a2611921690bb9f2f6c2a02e7269ab9b268f2f1bbed00",
      "targetHash": "f31b9ecc6ecbf78544ebd0460a72608ca1f005e2952d445c95f0d0fb67c9e332",
      "machineHash": "f31b9ecc6ecbf78544ebd0460a72608ca1f005e2952d445c95f0d0fb67c9e332",
      "machineText": "存在する理由",
      "status": "final",
      "sourcePreview": "Why it exists",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
