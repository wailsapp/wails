    "b0001-text-01": {
      "sourceHash": "cca166bb456e03ca3f435d24321e9a38f2d9614960f564ac1a5cdcd61fdf5669",
      "targetHash": "64cc952c603d2b5a60ca62a61e74ee9b4d10d37e46f6c970d250bd680302d13c",
      "machineHash": "64cc952c603d2b5a60ca62a61e74ee9b4d10d37e46f6c970d250bd680302d13c",
      "machineText": "`NewNotchWindow` membuat panel macOS berbentuk yang tidak mengaktifkan aplikasi dan melekat pada casing kamera. Wails mengelola penempatan native, sayap sambungan hitam, kanvas luar transparan, level jendela, perilaku Spaces, serta animasi tampil dan sembunyi opsional. Konten web Anda hanya menempati persegi panjang bagian dalam yang diminta. Memindahkan penunjuk ke dalam jendela akan segera menjadikan webview-nya sebagai jendela utama untuk input tanpa mengaktifkan aplikasi.",
      "status": "final",
      "sourcePreview": "`NewNotchWindow` creates a shaped, non-activating macOS panel attached to the\\ camera housing. Wails…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:30Z"
    },
    "b0002-text-01": {
