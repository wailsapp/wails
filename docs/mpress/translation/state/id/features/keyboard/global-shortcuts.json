    "b0011-text-01": {
      "sourceHash": "3727cb82718c653fa4e070850a094f588470895afdc562072261c5a443f62fa2",
      "targetHash": "54e08674719e285c369378d9d59aed998b8b16435f16a8adf2bbff5888a82b64",
      "machineHash": "54e08674719e285c369378d9d59aed998b8b16435f16a8adf2bbff5888a82b64",
      "machineText": "Pintasan global menggunakan format akselerator yang sama dengan akselerator menu dan pengikatan tombol:",
      "status": "final",
      "sourcePreview": "Global shortcuts use the same accelerator format as menu accelerators and key bindings:",
