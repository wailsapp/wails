    "b0034-text-01": {
      "sourceHash": "c76a0523772d593af32fa879b4720b59b786c0eb331ae1cadff6b7f9cf1f6f7d",
      "targetHash": "07d88cd78edecf3114410d44ed56aa9103f5ebe68b5caa0707fbd7bf8fadc353",
      "machineHash": "07d88cd78edecf3114410d44ed56aa9103f5ebe68b5caa0707fbd7bf8fadc353",
      "machineText": "Pintasan global menggunakan API tombol pintas Carbon Event Manager. Ini adalah mekanisme standar untuk tombol pintas tingkat sistem di macOS dan tidak memerlukan izin Aksesibilitas.",
      "status": "machine-translated",
      "sourcePreview": "Global shortcuts use the Carbon Event Manager's hot key API. This is the standard mechanism for syst…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
