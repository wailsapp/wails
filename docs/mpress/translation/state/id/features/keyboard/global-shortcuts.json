    "b0008-text-01": {
      "sourceHash": "6dd82f7136d33174798dbb820b051d8f6b9445c777f82492dcd03d264897b4f3",
      "targetHash": "cd5503119c6700a852de213a68e608e29511680f7af18fcd598baa2d6453e904",
      "machineHash": "cd5503119c6700a852de213a68e608e29511680f7af18fcd598baa2d6453e904",
      "machineText": "Anda dapat mendaftarkan pintasan sebelum memanggil `app.Run`. Pengikatan dengan sistem operasi kemudian dilakukan secara otomatis saat aplikasi dimulai.",
      "status": "final",
      "sourcePreview": "You can register shortcuts before calling `app.Run`. The binding with the operating system is then p…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:30Z"
    },
    "b0009-text-01": {
      "sourceHash": "b3e17f603e87044dab5b5adcef08e18dd9a2494a3349ff117edfb8fd0f639531",
      "targetHash": "411fa04c9ddbc6969292fb4bff25aaf16bbdbb8c2d6d06628806b017549be69a",
      "machineHash": "411fa04c9ddbc6969292fb4bff25aaf16bbdbb8c2d6d06628806b017549be69a",
      "machineText": "Callback berjalan di luar thread utama. Jika callback Anda perlu berinteraksi dengan jendela atau UI lainnya, metode jendela akan menanganinya untuk Anda. Namun, untuk pekerjaan khusus di thread utama, bungkus pekerjaan tersebut dengan `application.InvokeSync`.",
      "status": "final",
      "sourcePreview": "Callbacks run off the main thread. If your callback needs to interact with windows or other UI, that…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:30Z"
    },
