      "targetHash": "7bc5694ede017838192da82ec21f5780b1159f9c49ef207e3b3e4be8fa319051",
      "machineHash": "7bc5694ede017838192da82ec21f5780b1159f9c49ef207e3b3e4be8fa319051",
      "machineText": "Dalam sesi **X11**, Wails mengambil pintasan langsung dari server X, sehingga akselerator yang diminta diikat persis seperti yang ditentukan.",
      "status": "machine-translated",
      "sourcePreview": "On **X11** sessions Wails grabs the shortcut directly from the X server, so the requested accelerato…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
