    "b0007-text-01": {
      "sourceHash": "63043097a581ec447d2b30d49f0fc41ff5adf8105c44f0185954eb880a6627c3",
      "targetHash": "dc48154bddd986813997eeba72aa6a7496894d2dd290b133ce7dece592addd31",
      "machineHash": "dc48154bddd986813997eeba72aa6a7496894d2dd290b133ce7dece592addd31",
      "machineText": "`Register` menerima akselerator dan callback. Callback berjalan dalam goroutine tersendiri setiap kali pintasan ditekan.",
      "status": "final",
      "sourcePreview": "`Register` takes an accelerator and a callback. The callback runs on its own goroutine whenever the …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:30Z"
