      "machineHash": "5909fbe2d01dfbd7f7471528b76b00e64038d7142c90986f8f5e303a7df17491",
      "machineText": "Pintasan global menggunakan API Win32 `RegisterHotKey`. Pengulangan otomatis dinonaktifkan, sehingga menahan tombol hanya memicu callback satu kali, bukan berulang kali.",
      "status": "machine-translated",
      "sourcePreview": "Global shortcuts use the Win32 `RegisterHotKey` API. Auto repeat is suppressed, so holding the keys …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:09:31Z"
