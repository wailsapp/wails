    "b0014-text-01": {
      "sourceHash": "41b06e52a118d975e6c73599d692a87e2c3b2caa254dcbbb351aeb403aeaccff",
      "targetHash": "c692f56d0ad6393bfda34e4fcabdf776a33e47b5694ee37e40a1ae2797e7dbd4",
      "machineHash": "c692f56d0ad6393bfda34e4fcabdf776a33e47b5694ee37e40a1ae2797e7dbd4",
      "machineText": "Semua pintasan yang terdaftar dilepas secara otomatis saat aplikasi keluar, sehingga Anda tidak perlu membersihkannya secara manual.",
      "status": "final",
      "sourcePreview": "All registered shortcuts are released automatically when the application exits, so you do not need t…",
