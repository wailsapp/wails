    "b0001-text-01": {
      "sourceHash": "46ad1266ce3c4544e38a8718f461c2bc5714789e486be936b1b4ef6e625047bd",
      "targetHash": "9bc7191c719abd8245804294c67b97ff2f8de2cb9e482e90197ef313904edfc8",
      "machineHash": "9bc7191c719abd8245804294c67b97ff2f8de2cb9e482e90197ef313904edfc8",
      "machineText": "Pintasan global adalah pintasan papan ketik tingkat sistem yang dipicu tanpa bergantung pada aplikasi mana yang sedang memiliki fokus, selama aplikasi Wails Anda berjalan. Pintasan ini ideal untuk tombol pintas tampilkan/sembunyikan, alat perekaman cepat, kontrol media, dan fitur lain yang diharapkan pengguna dapat diakses dari mana saja.",
      "status": "machine-translated",
      "sourcePreview": "Global shortcuts are system-wide keyboard shortcuts that fire regardless of which application curren…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:09:31Z"
    },
    "b0002-text-01": {
      "sourceHash": "f712cadad74e5defbfb5c01e19666b09829715f6af9df4e303009b57f6f121a0",
      "targetHash": "ba14d5d8d8f57a9f9075689af69812a0790c498248329539422a3d3248df45a7",
      "machineHash": "ba14d5d8d8f57a9f9075689af69812a0790c498248329539422a3d3248df45a7",
      "machineText": "[Pengikatan tombol](/features/keyboard/shortcuts/) (`app.KeyBinding`) hanya dipicu saat salah satu jendela aplikasi Anda memiliki fokus. Pintasan global (`app.GlobalShortcut`) dipicu di seluruh sistem, bahkan saat aplikasi Anda berjalan di latar belakang. Gunakan yang sesuai dengan kebutuhan Anda.",
      "status": "machine-translated",
      "sourcePreview": "[Key bindings](/features/keyboard/shortcuts/) (`app.KeyBinding`) only fire while one of your applica…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:09:31Z"
    },
