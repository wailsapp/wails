    "b0016-text-01": {
      "sourceHash": "e28b23b9254d0fa19cd7dcf95d48b213d44d0181248b31687d7d808d898645b4",
      "targetHash": "adbe11f3766321dddb590c270cbbf0802cc21f18587789ccf39acb8027c9e836",
      "machineHash": "adbe11f3766321dddb590c270cbbf0802cc21f18587789ccf39acb8027c9e836",
      "machineText": "Ada dua kasus yang berbeda, dan Wails menanganinya secara berbeda.",
      "status": "final",
      "sourcePreview": "There are two distinct cases, and Wails handles them differently.",
