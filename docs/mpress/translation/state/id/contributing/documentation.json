    "b0005-text-01": {
      "sourceHash": "8ebbff32265c8b5935e918cfa25ee6f53a732d663c11ace25b8a5e4e3c935e93",
      "targetHash": "8093e5ac87b83cf6312789a88a2ba1b131535cd32bb216d6d086a73020992cdf",
      "machineHash": "8093e5ac87b83cf6312789a88a2ba1b131535cd32bb216d6d086a73020992cdf",
      "machineText": "Perintah tersebut menggunakan M-Press jika sudah terinstal; jika belum, penginstalnya akan mengunduh rilis resmi dan memverifikasi checksum. Perintah itu menyiapkan working copy kontribusi lokal dan membuka halaman yang dipilih di M-Press. Sebelum menjalankan pemeriksaan repositori, cocokkan `mpress version` dengan versi yang dipatok di bawah karena penginstal otomatis dapat mengunduh rilis yang lebih baru.",
      "status": "machine-translated",
      "sourcePreview": "The command uses M-Press if installed; otherwise its installer downloads an official release and ver…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
