    "b0004-text-01": {
      "sourceHash": "3e09cb225c46137d6aecbc4ed6a53480bfc43832f9f628fc31d06887bc6f8504",
      "targetHash": "7de40f44c526b2639c2606e31fc33a98d60f3f817a0a07ad7d3de310d0ae5a3f",
      "machineHash": "7de40f44c526b2639c2606e31fc33a98d60f3f817a0a07ad7d3de310d0ae5a3f",
      "machineText": "Buka **Kontribusi → Dokumentasi** di bilah sisi untuk membuka panduan ini. Untuk mengerjakan halaman tertentu, pilih **ikon edit** di header halaman tersebut, lalu pilih **Edit halaman ini secara lokal**. Salin perintah untuk sistem operasi Anda dan jalankan di terminal.",
      "status": "machine-translated",
      "sourcePreview": "Open **Contributing → Documentation** in the sidebar to reach this guide. To work on a particular pa…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
