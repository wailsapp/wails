    "b0024-text-01": {
      "sourceHash": "21f22fc1ff55c7a75b6b5574f826d92ee1b3fa64a2bd776efe2635278901f3c5",
      "targetHash": "d4eb01100a9a9906171a107412e548162e582ce5a0b47829cc0084c4697f0755",
      "machineHash": "d4eb01100a9a9906171a107412e548162e582ce5a0b47829cc0084c4697f0755",
      "machineText": "Hot reload—Setiap perubahan pada aset frontend akan memicu pemuatan ulang otomatis pada frontend aplikasi",
      "status": "final",
      "sourcePreview": "Hot reload - Any changes to frontend assets will trigger and auto reload of the application frontend",
      "provider": "codex",
