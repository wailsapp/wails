    "b0018-text-01": {
      "sourceHash": "8617028b2ca34e69a74eb22bbb71bf6899157ff497b095a822d654cfca782edc",
      "targetHash": "13a1083cd7fcb83203fbc9c4f1684720b73488f81fa29429970c3d7fb6936446",
      "machineHash": "13a1083cd7fcb83203fbc9c4f1684720b73488f81fa29429970c3d7fb6936446",
      "machineText": "Ya, cara kerjanya persis seperti server web, tetapi sebenarnya bukan server web.",
      "status": "final",
      "sourcePreview": "Yes, it works just like a webserver, except it isn't.",
