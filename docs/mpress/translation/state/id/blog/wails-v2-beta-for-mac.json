    "b0019-text-01": {
      "sourceHash": "ae6fcca1a03cf57b9f3f22be3089cfcae3b710a6c3a97fdb37ba68ddbee56e88",
      "targetHash": "2f059e13eb970c160d316121eca8f87bb5b68ece7171a8e3ca261baf48c8325e",
      "machineHash": "2f059e13eb970c160d316121eca8f87bb5b68ece7171a8e3ca261baf48c8325e",
      "machineText": "Jadi, bagaimana cara menyertakan aset saya?",
      "status": "final",
      "sourcePreview": "So how do I include my assets?",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0020-text-01": {
      "sourceHash": "48d705d794419374c335c65cac7cef32f970e4174656dff05fe94f8c693f30ab",
      "targetHash": "1f8786a579dd1c990f7a7c9090e148e50747e5a826249312a86633049b679805",
      "machineHash": "1f8786a579dd1c990f7a7c9090e148e50747e5a826249312a86633049b679805",
      "machineText": "Anda cukup meneruskan satu `embed.FS` yang berisi semua aset Anda ke konfigurasi aplikasi. Aset tersebut bahkan tidak harus berada di direktori teratas—Wails akan menanganinya untuk Anda.",
      "status": "final",
      "sourcePreview": "You just pass a single `embed.FS` that contains all your assets into your\\ application configuration…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0021-heading-01": {
