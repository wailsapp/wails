      "machineHash": "5f67e2d0a51ff9e60be7f9efb9d443fcfd5acf9d85a8d2ce7071278cf3f82695",
      "machineText": "Wah, kedengarannya seperti server web...",
      "status": "final",
      "sourcePreview": "Wow, that sounds like a webserver...",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
