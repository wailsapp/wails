      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0022-text-01": {
      "sourceHash": "c50dbd61000abcb691a783a0fc0d1fd3ec9aad8579587f13df6e09d51ab27578",
      "targetHash": "09126029eb7d7e8e48920b2e5e390cec2108e1dd9e9a5cd011474e6165f3f873",
      "machineHash": "09126029eb7d7e8e48920b2e5e390cec2108e1dd9e9a5cd011474e6165f3f873",
      "machineText": "Karena aset kini tidak perlu dibundel, hal ini memungkinkan pengalaman pengembangan yang benar-benar baru. Perintah `wails dev` yang baru akan membangun dan menjalankan aplikasi Anda, tetapi alih-alih menggunakan aset di dalam `embed.FS`, perintah tersebut memuatnya langsung dari disk.",
      "status": "final",
      "sourcePreview": "Now that assets don't need to be bundled, it's enabled a whole new development\\ experience. The new …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:28Z"
    },
    "b0023-text-01": {
      "sourceHash": "dd5a91289192c928dffca0ba880edfdf6a0521c5269f93fc6b9941e2c3e3599d",
      "targetHash": "2ba5200c73de99a86097d1fff4478e3a3edc56211f6e65f318b19fb920900e5a",
      "machineHash": "2ba5200c73de99a86097d1fff4478e3a3edc56211f6e65f318b19fb920900e5a",
      "machineText": "Perintah tersebut juga menyediakan fitur tambahan berikut:",
      "status": "final",
      "sourcePreview": "It also provides the additional features:",
