      "b0009-text-01": {
        "sourceHash": "d90109f48642042502bdb7f1aca92d86cf7df2dcba5585a885e0363715a0103d",
        "targetHash": "1e9885d854eb152bcab1ffc3d1a68d1575357ed0581316f2ca1a7e07479dd48c",
        "machineHash": "1e9885d854eb152bcab1ffc3d1a68d1575357ed0581316f2ca1a7e07479dd48c",
        "machineText": "Inilah bagian yang penting. Kelanjutan eksperimen bergantung pada masukan dari orang-orang yang benar-benar menggunakannya. Jika Anda mencoba salah satunya, kami benar-benar ingin mengetahui:",
        "status": "final",
        "sourcePreview": "This is the important part. Experiments live or die by what we hear back from\\ people actually using…",
