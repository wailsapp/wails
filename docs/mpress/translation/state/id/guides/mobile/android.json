    "b0054-text-01": {
      "sourceHash": "ddbe45ef30c85b0c596becf60ba212bd372a1fbd6bfee69b0fecfad4f7af9066",
      "targetHash": "8b9c3fbaaaf5cff0218aea7b23a178a7838400407dad64a6c458f6057f3fb547",
      "machineHash": "8b9c3fbaaaf5cff0218aea7b23a178a7838400407dad64a6c458f6057f3fb547",
      "machineText": "Kode desktop dapat dikompilasi tanpa perubahan pada `GOOS=android`; pemanggilan geometri, menu, dan baki sistem tidak melakukan operasi apa pun karena aplikasi Android menggunakan layar penuh.",
