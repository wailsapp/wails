      "machineHash": "c34bc5f71e187e83f21eba9d1cf385ae472dd60f952a37b7185992a6b75c1f0d",
      "machineText": "`android` *menyiratkan tag build `linux`* (Android menggunakan kernel Linux): file yang hanya ditujukan untuk Linux desktop memerlukan `//go:build linux \u0026\u0026 !android`, dan saat runtime `runtime.GOOS` bernilai `\"android\"`.",
      "status": "final",
      "sourcePreview": "`android` *implies the `linux` build tag* (Android is a Linux kernel): desktop-Linux-only files need…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:31Z"
    },
