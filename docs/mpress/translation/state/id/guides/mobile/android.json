    "b0055-text-01": {
      "sourceHash": "ea3ebeb260f9a9411b83ff115afdf72c91772a5fba327540342c06397df2aef9",
      "targetHash": "4fa80687e56a457cb77d54c7dcee3484370e8cd8d03a5bad66c798b9e09cbc08",
      "machineHash": "4fa80687e56a457cb77d54c7dcee3484370e8cd8d03a5bad66c798b9e09cbc08",
      "machineText": "`android` **menyiratkan tag build `linux`** (Android menggunakan kernel Linux): file khusus Linux desktop memerlukan `//go:build linux \u0026\u0026 !android`, dan saat runtime `runtime.GOOS` bernilai `\"android\"`.",
      "status": "machine-translated",
      "sourcePreview": "`android` **implies the `linux` build tag** (Android is a Linux kernel): desktop-Linux-only files ne…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T22:08:20Z"
    },
    "b0056-text-01": {
      "sourceHash": "0acc584d717da6f3cebfdbd891915eb658089910e0940599c0f9dd5224b68ff9",
      "targetHash": "b4f5c84b39ee0e0ff76a14b106adb6afe8bb92bed0fdf56baff2709d0922b095",
      "machineHash": "b4f5c84b39ee0e0ff76a14b106adb6afe8bb92bed0fdf56baff2709d0922b095",
      "machineText": "Ganti dialog penyimpanan file dan pemilihan direktori dengan penulisan ke sandbox aplikasi serta alur berbagi melalui intent. Dialog pembukaan file berfungsi dan mengimpor dokumen yang dipilih sebagai salinan dalam direktori cache, sehingga Anda mendapatkan jalur sistem file yang sebenarnya.",
      "status": "machine-translated",
      "sourcePreview": "Replace save-file and choose-directory dialogs with writes into the app sandbox plus an intent share…",
