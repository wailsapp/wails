      "targetHash": "e347a4279b21383200643b4d31109d98e01b4fcd7e6b318379ccad4f421ab7bd",
      "machineHash": "e347a4279b21383200643b4d31109d98e01b4fcd7e6b318379ccad4f421ab7bd",
