      "targetHash": "c1df9cb425a1bfcbeae3677c579118afe43250522b2f3e33b8c21363c4fa6bc6",
      "machineHash": "c1df9cb425a1bfcbeae3677c579118afe43250522b2f3e33b8c21363c4fa6bc6",
      "machineText": "Jika jendela masih kosong (misalnya dalam container yang tidak dapat melihat jalur modul), atur variabel lingkungan secara manual sebelum menjalankan aplikasi Anda:",
      "status": "machine-translated",
      "sourcePreview": "If you still see a blank window (for example in a container where the module path is not visible), s…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:41:20Z"
    },
    "b0054-text-01": {
