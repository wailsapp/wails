    "b0051-text-01": {
      "sourceHash": "3aa857798091c05b7f13fa78cf9e954173161f87da00630d4ec0e26104741a5a",
      "targetHash": "73c1b9ddfb4fc7ee6c97350581141f08c52c19d0b72222ae4af65d3bb4b86cae",
      "machineHash": "73c1b9ddfb4fc7ee6c97350581141f08c52c19d0b72222ae4af65d3bb4b86cae",
      "machineText": "Di Linux dengan driver proprietari NVIDIA, aplikasi Wails mungkin menampilkan jendela kosong atau putih saat dimulai. Hal ini disebabkan oleh bug WebKitGTK yang membuat perender DMA-BUF gagal dengan `gbm_bo_map()` saat digunakan bersama driver proprietari NVIDIA (memengaruhi X11 dan Wayland, driver versi 377–580+, GPU dari seri 10 dan GT 710 yang lebih lama).",
      "status": "machine-translated",
      "sourcePreview": "On Linux with NVIDIA proprietary drivers, Wails apps may show a blank or white window on startup. Th…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:41:20Z"
    },
    "b0052-text-01": {
      "sourceHash": "c84e97657b5e58724ebbbc4ada69052af7253fa81f3b3c57b00cf441c9106712",
