      "machineHash": "791b0bc6ea3fb29805f76b389beb6c938159572116c013ec49881f332eefe368",
      "machineText": "Wails tidak mempermasalahkan framework apa yang berada di `frontend/`. Wails hanya mengandalkan kontrak kecil yang tidak bergantung pada framework:",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:30Z"
