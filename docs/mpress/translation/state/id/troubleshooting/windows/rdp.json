    "b0006-text-01": {
      "sourceHash": "06e4acf0308131114e108506277c8f7217395c3e17a3ec2dff01d92c7dc3baef",
      "targetHash": "0449c6b2b610936d0f1a4f827587c763a3ca2c5070c90d0eb7de3ffc23eb64a4",
      "machineHash": "0449c6b2b610936d0f1a4f827587c763a3ca2c5070c90d0eb7de3ffc23eb64a4",
      "machineText": "Masalah ini paling sering terjadi pada klien Microsoft Remote Desktop di iOS, yang menyediakan monitor virtual yang dioptimalkan untuk Retina di tengah sesi. Klien RDP apa pun yang menghadirkan monitor dengan konteks DPI berbeda di tengah sesi dapat memicu perilaku yang sama.",
      "status": "final",
      "sourcePreview": "This is most often seen with the Microsoft Remote Desktop client on iOS, which provisions a Retina-o…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
