    "b0005-text-01": {
      "sourceHash": "d528a1d5773854641980b0aef423c93931f6338184cfc55d29b58214736e577b",
      "targetHash": "e100ae56adbc371019f3d4f634aa0c5a02bfc2640f5c7a8b4055d97437122684",
      "machineHash": "e100ae56adbc371019f3d4f634aa0c5a02bfc2640f5c7a8b4055d97437122684",
      "machineText": "Kondisi lambat ini tetap berlanjut setelah koneksi tersambung kembali dan baru hilang setelah mesin host dimulai ulang.",
      "status": "final",
      "sourcePreview": "The slow state persists across reconnects and only clears after the host machine is rebooted.",
