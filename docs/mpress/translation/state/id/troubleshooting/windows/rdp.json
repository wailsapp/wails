      "sourceHash": "799b9a9514031be2ec15a8792bda8b4c29a1b5811a428160c53813046a5f0275",
      "targetHash": "447180365e31e291616c9d73dd983d21f88b63f21dc1302cf32fecdc0bc7be64",
      "machineHash": "447180365e31e291616c9d73dd983d21f88b63f21dc1302cf32fecdc0bc7be64",
      "machineText": "Kapan perlu mengaktifkannya",
      "status": "final",
      "sourcePreview": "When to enable it",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:32Z"
    },
    "b0016-text-01": {
      "sourceHash": "0c3ce80389ffa7b2ee0008b1385065df4d3e50ab71cdf8f6cbadc98b739f63ef",
      "targetHash": "ae2bcb646e443673a895a84d0bda4c859c4c8fd30252d1495b8133c100c9d177",
      "machineHash": "ae2bcb646e443673a895a84d0bda4c859c4c8fd30252d1495b8133c100c9d177",
      "machineText": "Tetapkan `UseVisualHosting: true` jika aplikasi Anda sering digunakan melalui RDP, terutama melalui klien Microsoft Remote Desktop di iOS, dan mengalami macet selama beberapa detik saat membuka atau menutup jendela. Jika aplikasi Anda tidak berjalan melalui RDP, opsi ini tidak diperlukan dan Anda dapat mempertahankan nilai default.",
      "status": "final",
      "sourcePreview": "Set `UseVisualHosting: true` if your app is regularly used over RDP, especially the Microsoft Remote…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:32Z"
    },
