    "b0007-heading-01": {
      "sourceHash": "8d892c3c9826b727d4d2be362514e8b2a3cc70ef065ff4d6966df2bc12ca4cfe",
      "targetHash": "062d9eb23320e95f87193595d1672881c4e6c738123e550bb60c38b5692a8744",
      "machineHash": "062d9eb23320e95f87193595d1672881c4e6c738123e550bb60c38b5692a8744",
      "machineText": "Penyebabnya",
      "status": "final",
      "sourcePreview": "Why it happens",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:32Z"
