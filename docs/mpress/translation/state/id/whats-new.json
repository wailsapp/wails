    "b0010-text-01": {
      "sourceHash": "dedec9bcc95b13e7903f3318a8f656c684ce2ef9442d517a6d61c0f6fed86341",
      "targetHash": "6190973b62790e3bdc188772a00db9c06273b0695e157dc91212fd3ed0934a6e",
      "machineHash": "6190973b62790e3bdc188772a00db9c06273b0695e157dc91212fd3ed0934a6e",
      "machineText": "Penautan Jendela: Anda dapat mengaitkan jendela dengan ikon baki sistem. Saat diaktifkan, jendela ini akan dipusatkan relatif terhadap posisi ikon, sehingga memberikan cara praktis untuk mengakses aplikasi Anda dengan cepat.",
      "status": "final",
      "sourcePreview": "Window Attachment: You can associate a window with the system tray icon. When activated, this window…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:32Z"
