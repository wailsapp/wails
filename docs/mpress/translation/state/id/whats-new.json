      "targetHash": "ff23ea0724f306f75ed43b0fb595e2782373c583f4ee44204adee897caf887d9",
      "machineHash": "ff23ea0724f306f75ed43b0fb595e2782373c583f4ee44204adee897caf887d9",
      "machineText": "Pengembang dapat membuat, memanipulasi, dan mengelola jendela tersebut secara terprogram, sehingga memungkinkan antarmuka pengguna dinamis yang menyesuaikan diri dengan kebutuhan pengguna dan status aplikasi.",
      "status": "final",
      "sourcePreview": "Developers can create, manipulate, and manage these windows programmatically,\\ allowing for dynamic …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:32Z"
    },
