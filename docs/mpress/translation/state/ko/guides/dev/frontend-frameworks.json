    "b0018-text-01": {
      "sourceHash": "8a449bb8f7b7fc6f5a19868d04e4afe3eb4e94f058df87e3b82e43fab4ac8758",
      "targetHash": "98337e56ea2f3ad5ceb8c8e9c1fdd316a03f396e5a3978a0282a090d125b5c9a",
      "machineHash": "98337e56ea2f3ad5ceb8c8e9c1fdd316a03f396e5a3978a0282a090d125b5c9a",
      "machineText": "Wails는 `frontend/`에 어떤 프레임워크가 있는지 신경 쓰지 않습니다. 프레임워크와 무관한 다음의 몇 가지 규약만 사용합니다:",
      "status": "final",
      "sourcePreview": "Wails does not care which framework lives in `frontend/`. It only relies on a small,\\ framework-agno…",
