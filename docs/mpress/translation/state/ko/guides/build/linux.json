    "b0017-text-01": {
      "sourceHash": "84781f3e916189ecea0cb6dc18a593af67c9f3e1cb0bd50d19c3362e29092f17",
      "targetHash": "d32b57c26e18b37830981becafaa6873a93c89d997dd94ac6376b8e7a089e89c",
      "machineHash": "d32b57c26e18b37830981becafaa6873a93c89d997dd94ac6376b8e7a089e89c",
      "machineText": "AppImage는 WebKit과 그 도우미 프로세스를 함께 묶고, 번들 라이브러리가 해당 프로세스를 AppImage 내부에서 시작하도록 패치합니다. AppImage의 `AppRun`은 내부의 `usr/lib`에서 앱을 시작합니다. 이 위치에서는 패치된 경로가 WebKit의 bubblewrap 샌드박스 외부와 내부 모두에서 올바르게 해석되므로 샌드박스가 계속 활성화됩니다. 이 작업 디렉터리를 그대로 유지할 수 있는 경우에만 자체 `AppRun`을 제공하십시오.",
      "status": "machine-translated",
      "sourcePreview": "The AppImage bundles WebKit and its helper processes, and patches the bundled library to start them …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-10-25T21:40:49Z"
    },
