    "b0025-text-01": {
      "sourceHash": "ca7e8b93ad51bc6368972c3641d81261bef65160872a153c50b3f31318955ace",
      "targetHash": "80740c9cd590fca84f673348195467daa15d3893c6f1693a55b8db1e25c95646",
      "machineHash": "80740c9cd590fca84f673348195467daa15d3893c6f1693a55b8db1e25c95646",
      "machineText": "v2에 이르기까지 엄청난 노력이 필요했습니다. 초기 알파 버전부터 오늘 출시에 이르기까지 89명의 기여자가 약 2200개의 커밋을 했으며, 그 밖에도 훨씬 더 많은 분이 번역, 테스트, 피드백, 토론 포럼과 이슈 트래커에서의 도움을 제공해 주셨습니다. 여러분 한 분 한 분께 이루 말할 수 없이 감사드립니다. 또한 지침과 조언, 피드백을 제공해 주신 모든 프로젝트 후원자분께도 특별히 감사드립니다. 여러분이 해 주시는 모든 일에 진심으로 감사드립니다.",
      "status": "final",
      "sourcePreview": "Getting to v2 has been a huge effort. There have been ~2200 commits by 89\\ contributors between the …",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:36Z"
    },
    "b0026-text-01": {
      "sourceHash": "7b6a4778afa51184a13cfe7467046bdbe5080dbd3b2e89d5859945d1aa7e9e93",
      "targetHash": "3d1f5d1bb7af33fc8763f4bda03b654f13361c1445306a7288fccecea259bb34",
      "machineHash": "3d1f5d1bb7af33fc8763f4bda03b654f13361c1445306a7288fccecea259bb34",
      "machineText": "특별히 언급하고 싶은 분들이 몇 분 있습니다.",
      "status": "final",
      "sourcePreview": "There are a few people I'd like to give special mention to:",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:36Z"
