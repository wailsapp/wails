    "b0012-text-01": {
      "sourceHash": "48d705d794419374c335c65cac7cef32f970e4174656dff05fe94f8c693f30ab",
      "targetHash": "95fa88bfccbc21b195a2416b3d30173fa1cb4d70e90d6229ac6fb796e9553630",
      "machineHash": "95fa88bfccbc21b195a2416b3d30173fa1cb4d70e90d6229ac6fb796e9553630",
      "machineText": "모든 에셋이 들어 있는 단일 `embed.FS`을 애플리케이션 구성에 전달하기만 하면 됩니다. 에셋이 최상위 디렉터리에 있을 필요도 없습니다. Wails가 알아서 처리합니다.",
      "status": "final",
