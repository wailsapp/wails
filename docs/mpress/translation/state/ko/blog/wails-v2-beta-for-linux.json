    "b0016-text-01": {
      "sourceHash": "4019f2356f1f499a747fd979f26455e8aa77e870ca34e5e4db44d7567a514a13",
      "targetHash": "51609b54171160fd36a19c909cbc9bc2412c9cac5d9debfda7500676f0a16082",
      "machineHash": "51609b54171160fd36a19c909cbc9bc2412c9cac5d9debfda7500676f0a16082",
      "machineText": "핫 리로드 - 프런트엔드 에셋을 변경하면 애플리케이션 프런트엔드가 자동으로 다시 로드됩니다.",
