    "b0026-text-01": {
      "sourceHash": "4f28204aeb23a477a424717c0c37573642cea55047a93d25696383a31bad6e00",
      "targetHash": "70a435ecf1b7c91a1b7d500333650f98f2e4730196068d265307fc126983b9fd",
      "machineHash": "70a435ecf1b7c91a1b7d500333650f98f2e4730196068d265307fc126983b9fd",
      "machineText": "Windows용 Wails v2는 순수 Go로 작성되었으므로 docker 없이 Windows용으로 빌드할 수 있습니다.",
      "status": "final",
