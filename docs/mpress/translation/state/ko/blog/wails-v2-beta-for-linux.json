    "b0008-text-01": {
      "sourceHash": "75850d60f7c5d266b05c5a27c7770661e5eacb4b662a43545782f84fbead8199",
      "targetHash": "908d7e2b2958f7d136d0056d3c10391556750f8ae61d9d9dcb032f6746845a13",
      "machineHash": "908d7e2b2958f7d136d0056d3c10391556750f8ae61d9d9dcb032f6746845a13",
      "machineText": "v1의 큰 불편 중 하나는 전체 애플리케이션을 단일 JS 및 CSS 파일로 압축해야 한다는 점이었습니다. v2에서는 어떤 방식으로도 에셋을 번들로 묶을 필요가 없습니다. 로컬 이미지를 불러오고 싶으신가요? 로컬 src 경로와 함께 `\u003c../../../assets/blog-images\u003e` 태그를 사용하면 됩니다. 멋진 글꼴을 사용하고 싶으신가요? 글꼴을 복사한 후 CSS에 해당 경로를 추가하면 됩니다.",
      "status": "final",
      "sourcePreview": "A huge pain-point of v1 was the need to condense your entire application down to\\ single JS \u0026 CSS fi…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:36Z"
    },
