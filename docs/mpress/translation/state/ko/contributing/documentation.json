      "targetHash": "6ee53cfdcdd04930c7938f2ceca793d4c4db4cf928f848ae976b2346a1984fd5",
      "machineHash": "6ee53cfdcdd04930c7938f2ceca793d4c4db4cf928f848ae976b2346a1984fd5",
      "machineText": "문서 페이지에서 시작하기",
      "status": "machine-translated",
      "sourcePreview": "Start from a documentation page",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
