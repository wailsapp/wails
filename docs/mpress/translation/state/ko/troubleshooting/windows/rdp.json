    "b0006-text-01": {
      "sourceHash": "06e4acf0308131114e108506277c8f7217395c3e17a3ec2dff01d92c7dc3baef",
      "targetHash": "a9221b69c26b0453af85c034ef37ee3be79aaf5419cf89494e62a0f7c422fe48",
      "machineHash": "a9221b69c26b0453af85c034ef37ee3be79aaf5419cf89494e62a0f7c422fe48",
      "machineText": "이 문제는 세션 도중 Retina에 최적화된 가상 모니터를 프로비저닝하는 iOS용 Microsoft Remote Desktop 클라이언트에서 가장 흔히 발생합니다. 세션 도중 DPI 컨텍스트가 다른 모니터를 추가하는 모든 RDP 클라이언트에서 같은 동작이 발생할 수 있습니다.",
      "status": "final",
      "sourcePreview": "This is most often seen with the Microsoft Remote Desktop client on iOS, which provisions a Retina-o…",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "promptVersion": "mpress-translation-v2",
      "updatedAt": "2026-09-13T23:13:39Z"
