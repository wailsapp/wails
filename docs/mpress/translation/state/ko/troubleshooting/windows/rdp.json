    "b0003-text-01": {
      "sourceHash": "08a026f364fe72f8b99b6db4de2a46e4ee11d4df5b17bf78ff225aeee1ce0599",
      "targetHash": "07fc5bcd3e45e6c297179e8e56f1b93adb362345e0bd6bbde0566b9b24449c16",
      "machineHash": "07fc5bcd3e45e6c297179e8e56f1b93adb362345e0bd6bbde0566b9b24449c16",
      "machineText": "팝업 창을 열기 위해 클릭한 후 콘텐츠가 표시되기까지 약 4~8초가 걸립니다.",
