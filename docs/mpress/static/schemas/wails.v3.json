        "output": {
          "default": "bin",
          "description": "Project-relative output directory.",
          "type": "string"
        },
        "strip": {
          "default": true,
          "description": "Strip debug information from production binaries.",
          "type": "boolean"
        },
        "tags": {
          "default": [],
          "description": "Additional Go build tags.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trim_path": {
          "default": true,
          "description": "Remove local filesystem paths from production binaries.",
          "type": "boolean"
        },
        "vcs_info": {
          "default": false,
          "description": "Embed version-control metadata in the Go binary.",
          "type": "boolean"
