    "android": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "description": "Android application identifier.",
          "type": "string"
        },
        "comments": {
          "description": "Additional package metadata comments.",
          "type": "string"
        },
        "company": {
          "description": "Company or organisation name.",
          "type": "string"
        },
        "display_name": {
          "description": "Name displayed by the mobile platform.",
          "type": "string"
        },
        "icon": {
          "description": "Project-relative user-owned icon file.",
          "type": "string"
        },
        "manifest": {
          "description": "Project-relative user-owned platform or package manifest.",
          "type": "string"
        },
        "minimum_sdk": {
          "description": "Minimum supported Android SDK level.",
          "type": "integer"
        },
        "signing": {
          "additionalProperties": false,
          "properties": {
            "certificate": {
              "description": "Project-relative signing certificate file.",
              "type": "string"
            },
            "credential": {
              "description": "Named external credential reference; never secret material.",
              "type": "string"
            },
            "entitlements": {
              "description": "Project-relative Apple entitlements file.",
              "type": "string"
            },
            "identity": {
              "description": "Signing identity selected through the platform toolchain.",
              "type": "string"
            },
            "key_alias": {
              "description": "Alias of the Android signing key.",
              "type": "string"
            },
            "provisioning_profile": {
              "description": "Project-relative Apple provisioning profile.",
              "type": "string"
            },
            "thumbprint": {
              "description": "Windows certificate thumbprint.",
              "type": "string"
            },
            "timestamp_server": {
              "description": "URL of the signing timestamp service.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "target_sdk": {
          "description": "Android SDK level targeted by the application.",
          "type": "integer"
        },
        "version_code": {
          "description": "Monotonic Android release number.",
          "type": "integer"
        },
        "version_name": {
          "description": "Human-readable Android release version.",
          "type": "string"
        }
      },
      "type": "object"
