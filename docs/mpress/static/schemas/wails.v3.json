    "dev": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Development application arguments passed without shell expansion; supported on desktop and iOS. Android requires an empty list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "debounce_ms": {
          "default": 250,
          "description": "Delay used to coalesce development file changes.",
          "type": "integer"
        },
        "exclude": {
          "default": [
            ".git",
            ".wails",
            "bin",
            "node_modules",
            "frontend/dist"
          ],
          "description": "Development watcher exclusion patterns.",
