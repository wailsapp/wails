            "type": "string"
          },
          "type": "array"
        },
        "output": {
          "default": "dist",
          "description": "Project-relative output directory.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "hooks": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "cache": {
            "default": false,
            "description": "Allow this hook to use the artifact cache; complete inputs and outputs are required.",
