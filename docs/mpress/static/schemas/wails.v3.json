          },
          "directory": {
            "description": "Project-relative working directory used to invoke the hook.",
            "type": "string"
          },
          "inputs": {
            "default": [],
            "description": "Project-relative files or directories that determine a cached hook result.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "outputs": {
            "default": [],
            "description": "Project-relative files or directories produced completely by a cached hook.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "script": {
            "description": "Project-relative executable script invoked directly without a shell command string.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "script"
        ],
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "before_build",
          "after_build",
          "before_package",
          "after_package",
          "before_sign",
          "after_sign"
        ]
      },
      "type": "object"
    },
